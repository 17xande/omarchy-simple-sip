#!/usr/bin/env bash
# Run every test the plugin has. The Python suites run under /usr/bin/python3,
# the interpreter the plugin itself runs with (python-jeepney included).
set -euo pipefail
here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
echo "== Model.js"      && node "$here/model_test.js"
echo "== CallTracker"   && /usr/bin/python3 "$here/tracker_test.py"
echo "== file I/O"     && /usr/bin/python3 "$here/io_test.py"
echo "== daemon logic" && /usr/bin/python3 "$here/daemon_test.py"
echo "== manifest"      && omarchy plugin validate "$here/.."
echo "All green."
