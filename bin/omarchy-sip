def die(message: str) -> "NoReturn":  # noqa: F821
    print(f"omarchy-sip: {message}", file=sys.stderr)
    raise SystemExit(1)


def command_json(name: str, params: str | None, token: str | None) -> str:
    obj: dict[str, str] = {"command": name}
    if params:
        obj["params"] = params
    if token:
        obj["token"] = token
    return json.dumps(obj, separators=(",", ":"))


# --------------------------------------------------------------- config on disk


def open_dir_checked(name: str, dir_fd: int | None = None) -> int:
    """openat one path component as a directory, never following a symlink."""
    fd = os.open(
        name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC, dir_fd=dir_fd
    )
    try:
        st = os.fstat(fd)
        # O_DIRECTORY already guarantees a directory and O_NOFOLLOW that we did
        # not traverse a symlink. What neither guarantees is that this component
        # is not writable by somebody else, which is what would let them swap
        # the next one out from under us.
        if st.st_uid not in (0, os.getuid()):
            raise OSError(errno.EPERM, f"{name} is owned by uid {st.st_uid}")
        if st.st_mode & 0o022 and not st.st_mode & stat.S_ISVTX:
            raise OSError(errno.EPERM, f"{name} is writable by other users")
    except OSError:
        os.close(fd)
        raise
    return fd


def pin_dir(path: str, leaf_mode: int = 0o700, owned: bool = True) -> int:
    """Walk `path` from "/" one component at a time and return the leaf's fd.

    A descriptor is held at every step and the next component is opened
    relative to it, so the chain is never re-resolved from a string. This is
    the whole point: validating a *name* and reopening it later leaves a window
    in which another process running as this user can replace an intermediate
    directory and redirect everything underneath. Callers get the descriptor
    and do all their work relative to it.

    `leaf_mode` is the mode a leaf is created with. It is also *enforced* on an
    already-existing leaf, but only when `owned` -- pass owned=False for a
    directory that merely happens to hold one of our files, so we never re-mode
    somebody else's directory. See unit_fd().
    """
    fd = open_dir_checked("/")
    try:
        parts = [comp for comp in path.split("/") if comp]
        created = False
        for depth, comp in enumerate(parts):
            last = depth == len(parts) - 1
            try:
                nxt = open_dir_checked(comp, dir_fd=fd)
            except FileNotFoundError:
                # Intermediates are created at the conventional 0755: widening
                # or narrowing somebody's ~/.config is not ours to decide. Only
                # our own leaf is private.
                os.mkdir(comp, leaf_mode if last else 0o755, dir_fd=fd)
                created = last
                nxt = open_dir_checked(comp, dir_fd=fd)
            os.close(fd)
            fd = nxt
        # mkdir's mode is masked by the umask, so a leaf we just created still
        # has to be set exactly. An *existing* leaf is only re-moded when it is
        # ours: see dir_fd_for().
        if (owned or created) and stat.S_IMODE(os.fstat(fd).st_mode) != leaf_mode:
            os.fchmod(fd, leaf_mode)     # on the fd: no pathname to re-resolve
        return fd
    except OSError as exc:
        os.close(fd)
        die(f"cannot open {path} safely: {exc}")


_DIR_FDS: dict[str, int] = {}


def dir_fd_for(path: str, leaf_mode: int = 0o700, owned: bool = True) -> int:
    """Pin `path` once per process and reuse the descriptor thereafter."""
    fd = _DIR_FDS.get(path)
    if fd is None:
        fd = _DIR_FDS[path] = pin_dir(path, leaf_mode, owned)
    return fd


def conf_fd() -> int:
    return dir_fd_for(CONF_DIR)


def run_fd() -> int:
    return dir_fd_for(RUN_DIR)


def unit_fd() -> int:
    """Pin ~/.config/systemd/user -- but never re-mode it.

    This directory is systemd's, not ours: we only drop one unit file into it.
    Forcing a mode on a directory the plugin does not own would silently widen
    a 0700 ~/.config/systemd/user to 0755 on every `status` poll. It is created
    at the conventional 0755 if missing and otherwise left exactly as found.
    """
    return dir_fd_for(UNIT_DIR, 0o755, owned=False)


def open_checked(
    name: str,
    flags: int,
    mode: int = 0o600,
    want=stat.S_ISREG,
    blocking: bool = True,
    dir_fd: int | None = None,
) -> int:
    """os.open with the checks a shared directory demands.

    `name` is a basename resolved against `dir_fd`, so the parent chain is the
    pinned one. O_NOFOLLOW refuses a symlink swapped in for the final component;
    O_NONBLOCK means a FIFO swapped in for a regular file cannot park us inside
    open(); and the type/owner test runs on fstat of the very descriptor we go
    on to use, so it cannot be raced between the check and the read.
    """
    fd = os.open(
        name,
        flags | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_NOCTTY | os.O_CLOEXEC,
        mode,
        dir_fd=dir_fd,
    )
    try:
        st = os.fstat(fd)
        if not want(st.st_mode):
            raise OSError(errno.EINVAL, f"{name} is not the expected file type")
        if st.st_uid != os.getuid():
            raise OSError(errno.EPERM, f"{name} is not owned by this user")
        # O_NONBLOCK was only ever an open()-time guard for everything but the
        # sockets, so restore the mode the caller actually wants.
        os.set_blocking(fd, blocking)
    except OSError:
        os.close(fd)
        raise
    return fd


def read_bounded(name: str, dir_fd: int, limit: int = MAX_FILE) -> str:
    """Whole-file read through a validated descriptor, capped at `limit`."""
    try:
        fd = open_checked(name, os.O_RDONLY, dir_fd=dir_fd)
    except OSError:
        return ""
    try:
        chunks: list[bytes] = []
        got = 0
        while got < limit:
            chunk = os.read(fd, min(65536, limit - got))
            if not chunk:
                break
            chunks.append(chunk)
            got += len(chunk)
        return b"".join(chunks).decode("utf-8", "replace")
    except OSError:
        return ""
    finally:
        os.close(fd)


def read_exact(name: str, dir_fd: int, limit: int) -> str | None:
    """The whole file as text, for rewriting it: None when it does not
    exist. Unlike read_bounded, which clips and replaces undecodable bytes
    -- fine for reading, lossy for a read-modify-write -- this refuses a file
    over `limit` or one that is not UTF-8, so nothing is ever written back
    that the user did not have."""
    try:
        fd = open_checked(name, os.O_RDONLY, dir_fd=dir_fd)
    except FileNotFoundError:
        return None
    try:
        chunks, got = [], 0
        while got <= limit:
            chunk = os.read(fd, 65536)
            if not chunk:
                break
            chunks.append(chunk)
            got += len(chunk)
    finally:
        os.close(fd)
    if got > limit:
        die(f"{name} is larger than {limit} bytes -- not rewriting it")
    try:
        return b"".join(chunks).decode("utf-8")
    except UnicodeDecodeError:
        die(f"{name} is not UTF-8 -- not rewriting it")


def write_file(name: str, content: str | bytes, dir_fd: int, mode: int = 0o600) -> None:
    """Write `name` by creating a fresh file and renaming it into place.

    Never O_TRUNC an existing name. O_NOFOLLOW stops a symlink but not a
    same-owner *hard link*: truncating in place would write our new contents --
    for `accounts`, the SIP password -- straight into a file somebody else
    already holds a link to. rename(2) replaces the directory entry instead, so
    a planted link keeps the old bytes and never sees the new ones.
    """
    # Unpredictable, so nobody can pre-create or pre-link the temp name; O_EXCL
    # then guarantees a brand-new inode with no pre-existing links.
    tmp = f".{name}.{os.getpid()}.{secrets.token_hex(8)}.tmp"
    fd = os.open(
        tmp,
        os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC,
        mode,
        dir_fd=dir_fd,
    )
    renamed = False
    try:
        os.fchmod(fd, mode)               # on the fd, before any content lands
        data = content.encode("utf-8") if isinstance(content, str) else content
        while data:
            data = data[os.write(fd, data) :]
        os.fsync(fd)
        st = os.fstat(fd)                 # the still-open write fd: no reopen gap
        if not stat.S_ISREG(st.st_mode) or st.st_uid != os.getuid():
            raise OSError(errno.EPERM, f"{tmp} changed identity while being written")
        os.rename(tmp, name, src_dir_fd=dir_fd, dst_dir_fd=dir_fd)
        renamed = True
    finally:
        os.close(fd)
        if not renamed:
            try:
                os.unlink(tmp, dir_fd=dir_fd)
            except OSError:
                pass


def write_private(name: str, content: str | bytes, dir_fd: int) -> None:
    """Create/replace a 0600 file without ever widening its mode."""
    write_file(name, content, dir_fd, 0o600)


def exists_at(name: str, dir_fd: int) -> bool:
    """Does `name` exist in the pinned directory (symlink included)?"""
    try:
        os.lstat(name, dir_fd=dir_fd)
        return True
    except OSError:
        return False


def parse_account_line(line: str) -> dict:
    """Split one accounts line into its display name, URI and parameters.

    Only ever needs to read what `account set` writes: an optional quoted
    display name, the URI in angle brackets, then `;key=value` fields. The
    writer refuses `;`, `"`, CR and LF in every value, so a `;` after the
    closing `>` always starts a field. Values are clipped, and at most 32
    fields are kept, so a hand-edited or substituted file cannot hand back
    anything large.
    """
    line = line.strip()
    display = ""
    if line.startswith('"'):
        end = line.find('"', 1)
        if end > 0:
            display, line = line[1:end], line[end + 1 :].strip()
    uri, rest = line, ""
    if line.startswith("<") and ">" in line:
        uri, rest = line[1 : line.index(">")], line[line.index(">") + 1 :]
    elif ";" in line:
        uri, rest = line.split(";", 1)
        rest = ";" + rest
    params: dict[str, str] = {}
    raw: list[str] = []
    for field in rest.split(";")[1:33]:
        key, _, value = field.partition("=")
        key = key.strip()
        if key:
            # Quotes are the grammar's, not the value's; whitespace is kept --
            # a password that ends in a space is a password that ends in a space.
            params[clip(key, 64)] = clip(value.strip('"'), MAX_ACCOUNT_FIELD)
            raw.append(field)
    return {"display": clip(display, MAX_ACCOUNT_FIELD), "uri": clip(uri.strip()),
            "params": params, "raw": raw}


def account_entry() -> dict | None:
    """The first meaningful line of the accounts file, parsed, or None."""
    for line in read_bounded(ACCOUNTS, conf_fd(), MAX_ACCOUNTS_FILE).split("\n"):
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        return parse_account_line(line)
    return None


# Settings the daemon acts on by itself -- it runs whether or not the shell
# does, so it cannot read the panel's settings from shell.json. The panel
# writes them here (`omarchy-sip option set`); only these keys, only booleans.
MAX_OPTIONS_FILE = 4096
OPTION_DEFAULTS = {
    "notifications": True,   # incoming-call and missed-call notifications
    "regAlerts": True,       # notify when registration has been lost a while
    "dnd": False,            # reject incoming calls with 480, still log them
    "aec": False,            # load webrtc_aec (needs a daemon restart)
}


def read_options(dir_fd: int | None = None) -> dict:
    """The daemon's options: defaults, overlaid with any valid stored values.

    An oversized file is clipped, fails to parse, and reads as the defaults;
    unknown keys and non-boolean values are ignored rather than trusted.
    """
    out = dict(OPTION_DEFAULTS)
    raw = read_bounded(OPTIONS, conf_fd() if dir_fd is None else dir_fd, MAX_OPTIONS_FILE)
    try:
        obj = json.loads(raw) if raw.strip() else {}
    except ValueError:
        obj = {}
    if isinstance(obj, dict):
        for key in OPTION_DEFAULTS:
            if isinstance(obj.get(key), bool):
                out[key] = obj[key]
    return out


def write_options(options: dict, dir_fd: int | None = None) -> None:
    clean = {key: bool(options.get(key, default)) for key, default in OPTION_DEFAULTS.items()}
    write_private(OPTIONS, json.dumps(clean, separators=(",", ":")) + "\n",
                  conf_fd() if dir_fd is None else dir_fd)


def account_transport() -> str:
    """The transport this account registers with, for sip_transports.

    Defaults to udp, which is both baresip's default and what an account with
    no explicit transport= will use.
    """
    entry = account_entry()
    value = (entry or {}).get("params", {}).get("transport", "").strip().lower()
    return value if value in ("udp", "tcp", "tls") else "udp"


def ensure_config() -> None:
    fd = conf_fd()
    for name in (ACCOUNTS, CONTACTS):
        if not exists_at(name, fd):
            write_private(name, "", fd)
    interface = f"net_interface\t\t{SIP_INTERFACE}" if SIP_INTERFACE else ""
    # Echo cancellation, opt-in: it is what makes laptop speakers usable
    # without a headset, and costs CPU and a little latency with one. It is an
    # audio filter module, so it only takes effect when baresip starts.
    aec = (
        "\n# echo cancellation (the echoCancellation setting)\n"
        "module\t\t\twebrtc_aec.so\n"
    ) if read_options(fd).get("aec") else ""
    # Regenerated every start: the module list and the transport are ours, not
    # the user's, so a stale config can never quietly break calls -- and the
    # transport has to be re-derived whenever the account changes.
    write_private(RINGTONE, ringtone_wav(), fd)
    write_private(
        CONFIG,
        BARESIP_CONFIG.format(
            listen=SIP_LISTEN,
            transports=account_transport(),
            interface=interface,
            aec=aec,
            ring=os.path.join(CONF_DIR, RINGTONE),
        ),
        fd,
    )


def unit_python() -> str:
    """Interpreter to bake into the unit.

    A relative or `env`-resolved interpreter can land on a version manager's
    shim (mise, pyenv, asdf) that disappears under the service, or on whatever
    a writable PATH entry points at. The distro python is always present on
    Arch and is the only thing baked in here; there is deliberately no
    fallback to `sys.executable`, because a process started through a
    redirected interpreter would otherwise persist that choice into the unit.
    """
    if trusted_bin("python3") is None:
        die("no python3 in /usr/local/bin, /usr/bin or /bin -- cannot write a unit")
    return PYTHON


def unit_text() -> str:
    return UNIT_TEMPLATE.format(self=SELF, python=unit_python(), path=CHILD_PATH)


def write_unit() -> None:
    write_file(UNIT, unit_text(), unit_fd(), 0o644)
    if systemctl("daemon-reload") != 0:
        die("systemctl --user daemon-reload failed")


def sync_unit() -> bool:
    """Rewrite the installed unit whenever it differs from what we generate.

    Without this a hardened unit only ever reaches a fresh install: `start`
    skips writing when a unit already exists and `restart` never wrote one, so
    everybody who installed before a change keeps running the old ExecStart --
    the interpreter flags and the environment scrubbing in the template would
    be a silent no-op for exactly the people who already trusted the plugin.
    Content-compared rather than versioned so any drift is repaired, including
    a hand-edit. Returns True when it rewrote.
    """
    if not unit_installed():
        return False
    if read_bounded(UNIT, unit_fd()) == unit_text():
        return False
    write_unit()
    return True


def unit_installed() -> bool:
    return exists_at(UNIT, unit_fd())


SYSTEMCTL_TIMEOUT = 15.0    # a wedged --user manager must not hang the CLI


def systemctl(*args: str) -> int:
    """Run `systemctl --user`, bounded and with its output thrown away.

    Nothing that calls this ever reads stdout/stderr -- every call site only
    ever wanted the returncode -- so DEVNULL rather than capturing is both the
    simplest fix and the strongest one: zero bytes retained rather than an
    unbounded buffer that happens not to be read. `timeout` matters
    independently of whatever supervises this process: the QML watchdog kills
    the CLI's own pid when it runs too long, but Quickshell's Process exposes
    no process-group semantics, so a subprocess this CLI spawned and left
    hanging is not guaranteed to die with it. Bounding the call here means a
    wedged `systemctl` cannot outlive it regardless of what happens above.
    -1 on timeout is deliberately not a valid systemctl exit code, so callers
    that check `!= 0` treat it as the failure it is.
    """
    try:
        return subprocess.run(
            [SYSTEMCTL, "--user", *args],
            timeout=SYSTEMCTL_TIMEOUT,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        ).returncode
    except subprocess.TimeoutExpired:
        return -1


# The only variables baresip actually needs: XDG_RUNTIME_DIR to find the
# PipeWire/Pulse socket and the session bus, DBUS_SESSION_BUS_ADDRESS for
# ctrl_dbus when it is set explicitly, HOME because libraries expect one, and
# a fixed PATH. Everything else -- PYTHON*, LD_PRELOAD, LD_LIBRARY_PATH, and
# whatever else happens to be in a long-lived shell's environment -- is
# dropped rather than handed to the process that holds the SIP credentials.
CHILD_PATH = "/usr/local/bin:/usr/bin:/bin"
CHILD_ENV_KEYS = ("XDG_RUNTIME_DIR", "DBUS_SESSION_BUS_ADDRESS", "HOME", "USER", "LANG")


def child_env() -> dict[str, str]:
    env = {k: os.environ[k] for k in CHILD_ENV_KEYS if k in os.environ}
    env["PATH"] = CHILD_PATH
    return env


def clip(value, limit: int = MAX_FIELD) -> str:
    return str(value)[:limit]


def account_aor() -> str:
    """AOR from the first meaningful line of the accounts file."""
    entry = account_entry()
    return entry["uri"] if entry else ""


# ------------------------------------------------------------------- the daemon


class ControlHub:
    """The daemon's unix-socket front door.

    One listening socket, N connected clients. Every baresip event and every
    command response is broadcast to all of them, and commands arrive back as
    newline-delimited JSON. This replaces a FIFO plus an append-only journal
    file, which means no persistent object has to be reopened by pathname to
    move a message -- there is nothing left in the message path for another
    local process to substitute or truncate.

    The socket is created inside an already-pinned directory descriptor, at
    umask 0177 so it is 0600 from the instant it exists rather than after a
    chmod that could be raced.
    """

    MAX_OUTBOX = 1 << 20      # per client, before we hang up on them

    def __init__(self, dir_fd: int, name: str = CONTROL) -> None:
        self.dir_fd = dir_fd
        self.name = name
        self.clients: dict[socket.socket, dict] = {}
        # Replayed to every client that connects from here on. CTRL_CONNECTED is
        # broadcast once, when baresip's bus comes up, so without this a client
        # that connects later -- which is every client, the daemon outlives the
        # shell -- never learns the daemon is up and never resets its reconnect
        # backoff. The same goes for the current options and the last
        # voicemail summary. State, not history: one record per kind, the
        # latest, replayed in the order the kinds first appeared.
        self.greetings: dict[str, bytes] = {}
        try:
            os.unlink(name, dir_fd=dir_fd)   # a stale socket from a crash
        except FileNotFoundError:
            pass
        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.sock.setblocking(False)
        old_umask = os.umask(0o177)
        try:
            self.sock.bind(f"/proc/self/fd/{dir_fd}/{name}")
        finally:
            os.umask(old_umask)
        self.sock.listen(MAX_CLIENTS)

    def fileno(self) -> int:
        return self.sock.fileno()

    def accept(self) -> socket.socket | None:
        try:
            conn, _ = self.sock.accept()
        except (BlockingIOError, OSError):
            return None
        if len(self.clients) >= MAX_CLIENTS:
            conn.close()
            return None
        # The socket is 0600 inside a 0700 directory, so this should be
        # unreachable by anyone else already -- but the kernel will tell us who
        # is actually on the other end, so ask rather than infer it from the
        # permissions of a pathname. A client that is not this uid is refused.
        try:
            creds = conn.getsockopt(
                socket.SOL_SOCKET, socket.SO_PEERCRED, struct.calcsize("3i")
            )
            _pid, uid, _gid = struct.unpack("3i", creds)
        except OSError:
            conn.close()
            return None
        if uid != os.getuid():
            conn.close()
            return None
        conn.setblocking(False)
        self.clients[conn] = {"buf": b"", "out": b"", "dropping": False, "wdead": False}
        for record in self.greetings.values():
            self.send(conn, record)
        return conn

    def drop(self, conn: socket.socket) -> None:
        self.clients.pop(conn, None)
        try:
            conn.close()
        except OSError:
            pass

    def read_commands(self, conn: socket.socket) -> list[bytes]:
        """Complete command lines from one client, or [] and a dropped client.

        The per-client buffer is capped exactly like the old FIFO reader: a
        client that never sends a newline cannot grow daemon memory, and an
        oversized command is discarded and resynchronised at the next newline.
        """
        state = self.clients.get(conn)
        if state is None:
            return []
        try:
            chunk = conn.recv(65536)
        except BlockingIOError:
            return []
        except OSError:
            chunk = b""
        if not chunk:
            self.drop(conn)
            return []
        state["buf"] += chunk
        lines: list[bytes] = []
        while b"\n" in state["buf"]:
            raw, _, state["buf"] = state["buf"].partition(b"\n")
            if state["dropping"]:
                state["dropping"] = False
                continue
            if len(raw) > MAX_LINE:
                continue
            raw = raw.strip()
            if raw:
                lines.append(raw)
        if len(state["buf"]) > MAX_LINE:
            state["buf"] = b""
            state["dropping"] = True
        return lines

    def broadcast(self, text: str) -> None:
        """Send one record to every client, capped at MAX_LINE.

        One JSON object per line is the contract every reader relies on, so
        newlines are flattened and an oversized record becomes a marker.
        """
        text = text.replace("\r", " ").replace("\n", " ")
        if len(text) > MAX_LINE:
            text = json.dumps(
                {"type": "EVENT_DROPPED", "reason": "oversized record"},
                separators=(",", ":"),
            )
        data = (text + "\n").encode("utf-8", "replace")
        for conn in list(self.clients):
            self.send(conn, data)

    MAX_GREETINGS = 8

    def greet(self, text: str, kind: str | None = None) -> None:
        """Broadcast a record and keep it as the greeting of its kind.

        `kind` defaults to the record's own "type". A record too large for a
        line is broadcast as the usual marker and not kept.
        """
        if kind is None:
            try:
                kind = str(json.loads(text).get("type") or "")
            except (ValueError, AttributeError):
                kind = ""
        if len(text) <= MAX_LINE and (kind in self.greetings or len(self.greetings) < self.MAX_GREETINGS):
            self.greetings[kind] = (text.replace("\r", " ").replace("\n", " ") + "\n").encode("utf-8", "replace")
        self.broadcast(text)

    def send(self, conn: socket.socket, data: bytes) -> None:
        state = self.clients.get(conn)
        if state is None or state["wdead"]:
            return
        state["out"] += data
        self.flush(conn)

    def flush(self, conn: socket.socket) -> None:
        """Push what we can without blocking; hang up on a client that stalls.

        A failed write does *not* drop the client. The two directions are
        independent: `omarchy-sip send` is fire-and-forget, so it has closed its
        end before the daemon even accepts it, and dropping it here would throw
        away the command already sitting in its receive buffer -- which is
        exactly what greeting every new client silently did to every dial,
        accept and hangup the panel issued. Only read_commands() decides a
        client is finished, because only the read direction can tell us whether
        it still has something to say.
        """
        state = self.clients.get(conn)
        if state is None or not state["out"]:
            return
        try:
            sent = conn.send(state["out"])
            state["out"] = state["out"][sent:]
        except BlockingIOError:
            pass
        except OSError:
            state["wdead"] = True    # nothing more can be written to this one
            state["out"] = b""       # ...so it cannot grow, either
            return
        if len(state["out"]) > self.MAX_OUTBOX:
            # A reader that has stopped reading must not become the daemon's
            # memory leak. Unlike a write error this is a live peer choosing not
            # to drain, so hanging up is still the right answer.
            self.drop(conn)

    def flush_all(self) -> None:
        for conn in list(self.clients):
            self.flush(conn)

    def close(self) -> None:
        for conn in list(self.clients):
            self.drop(conn)
        try:
            self.sock.close()
        finally:
            try:
                os.unlink(self.name, dir_fd=self.dir_fd)
            except OSError:
                pass


# Set for the lifetime of the daemon; None in every short-lived CLI process,
# where an event simply has nowhere to go.
_HUB: ControlHub | None = None


def journal(obj: dict) -> None:
    if _HUB is not None:
        _HUB.broadcast(json.dumps(obj, separators=(",", ":")))


HISTORY_LIMIT = 50

MAX_CONTACTS = 200
MAX_CONTACT_NAME = 128
CONTACT_URI = re.compile(r"^sips?:[A-Za-z0-9._~:/@%+*#-]{1,250}$")   # the dial grammar


def sip_address(text: str) -> str:
    """peer_uri(), but only for an address that really is sip: or sips: --
    peer_uri() assumes sip: for anything scheme-less, which is right for a
    caller ID and wrong for something a person saved as `tel:` or `http:`."""
    value = str(text or "").strip()
    if "<" in value:
        value = value.split("<", 1)[1]
    if not re.match(r"^\s*sips?:", value, re.IGNORECASE):
        return ""
    uri = peer_uri(value)
    return uri if CONTACT_URI.match(uri) else ""


def parse_contacts(text: str) -> list[dict]:
    """baresip's contacts file -- `"Name" <sip:uri>;params`, one per line --
    as [{name, uri}]. Bounded: at most MAX_CONTACTS entries, names clipped,
    and a URI that would not pass the dial grammar is skipped, since the
    panel dials what it finds here."""
    out: list[dict] = []
    for line in text.split("\n"):
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        name = ""
        if line.startswith('"'):
            end = line.find('"', 1)
            if end < 0:
                continue
            name, line = line[1:end], line[end + 1 :].strip()
        uri = sip_address(line)
        if not uri:
            continue
        # baresip's call blocking (`;access=block`) is a contact line too, but
        # not someone to call: it is kept in the file and left out of the list.
        tail = line.split(">", 1)[1] if ">" in line else ""
        if re.search(r";\s*access\s*=\s*block\b", tail, re.IGNORECASE):
            continue
        out.append({"name": clip(name, MAX_CONTACT_NAME), "uri": uri})
        if len(out) >= MAX_CONTACTS:
            break
    return out


def read_contacts(dir_fd: int | None = None) -> list[dict]:
    return parse_contacts(read_bounded(CONTACTS, conf_fd() if dir_fd is None else dir_fd, MAX_FILE))


def contact_name_for(uri: str, contacts: list[dict], domain: str = "") -> str:
    """The saved name for a peer, matched on the bare address; mirrors
    Model.contactName(). Falls back to the user part alone when exactly one
    contact has it -- an extension saved against another name for the PBX
    still matches -- but only for a call from the account's own domain:
    anyone can call from sip:1001@their-own-host, or from an IP literal."""
    target = peer_uri(uri)
    if not target:
        return ""
    for c in contacts:
        if c["uri"].partition(":")[2] == target.partition(":")[2]:
            return c["name"]
    host = target.partition("@")[2].split(":")[0].lower() if "@" in target else ""
    if not host or host != domain.split(":")[0].lower():
        return ""
    user = target.partition(":")[2].split("@", 1)[0]
    matches = [c for c in contacts if c["uri"].partition(":")[2].split("@", 1)[0] == user]
    return matches[0]["name"] if len(matches) == 1 and len(user) >= 3 else ""


def contact_line(contact: dict) -> str:
    return f'"{contact["name"]}" <{contact["uri"]}>' if contact["name"] else f'<{contact["uri"]}>'


def peer_uri(uri: str) -> str:
    """The bare address of a peer: display name, angle brackets and URI
    parameters removed, scheme kept -- `"Bob" <sip:+1555@gw;user=phone>` is
    `sip:+1555@gw`. The log is what the panel redials from, and parameters
    are exactly what the dial grammar refuses; mirrors Model.redialTarget().
    """
    value = str(uri or "").strip()
    if "<" in value:
        value = value.split("<", 1)[1]
    value = value.split(">", 1)[0].strip()
    scheme, sep, rest = value.partition(":")
    if not sep or scheme.lower() not in ("sip", "sips"):
        scheme, rest = "sip", value
    rest = rest.split(";", 1)[0].split("?", 1)[0]
    return f"{scheme.lower()}:{rest}" if rest else ""


class CallTracker:
    """Turns the event stream into a persistent call log.

    This lives in the daemon rather than the panel because the daemon is the
    only thing running continuously: a call that starts and ends while the
    shell is restarting still gets recorded. A call is "missed" when it came
    in and never reached CALL_ESTABLISHED.
    """

    def __init__(self, dir_fd: int, name: str = HISTORY, limit: int = HISTORY_LIMIT) -> None:
        self.dir_fd = dir_fd
        self.name = name
        self.limit = limit
        self.open_calls: dict[str, dict] = {}

    def handle(self, event: dict) -> None:
        etype = event.get("type")
        call_id = event.get("id") or "-"
        if etype in ("CALL_INCOMING", "CALL_OUTGOING"):
            self.open_calls[call_id] = {
                "direction": "in" if etype == "CALL_INCOMING" else "out",
                "peer": peer_uri(event.get("peeruri") or ""),
                "started": time.time(),
                "answered": False,
                "answeredAt": 0.0,
            }
        elif etype == "CALL_ESTABLISHED":
            call = self.open_calls.get(call_id)
            if call:
                call["answered"] = True
                call["answeredAt"] = time.time()
        elif etype == "CALL_CLOSED":
            call = self.open_calls.pop(call_id, None)
            if call:
                self.append(call, "DND" if call.get("dnd") else (event.get("param") or ""))

    def mark_dnd(self, call_id: str) -> None:
        """This call was turned away under Do Not Disturb; log it as such."""
        call = self.open_calls.get(call_id or "-")
        if call:
            call["dnd"] = True

    def append(self, call: dict, reason: str) -> None:
        now = time.time()
        record = {
            "ts": round(call["started"], 3),
            "direction": call["direction"],
            "peer": call["peer"],
            # An unanswered inbound call is a miss; an unanswered outbound one
            # is just a call that was not picked up.
            "missed": call["direction"] == "in" and not call["answered"],
            "duration": int(now - call["answeredAt"]) if call["answered"] else 0,
            "reason": reason,
            # When it was logged, which is what "seen since" compares against:
            # a call that rang while the panel was open started before the
            # panel was opened, but was not missed until after.
            "end": round(now, 3),
        }
        try:
            lines = self.read_lines()
            lines.append(json.dumps(record, separators=(",", ":")))
            write_private(self.name, "\n".join(lines[-self.limit :]) + "\n", self.dir_fd)
        except OSError:
            pass   # history is a nicety; never let it take the daemon down

    def read_lines(self) -> list[str]:
        lines = []
        for raw in read_bounded(self.name, self.dir_fd).split("\n"):
            raw = raw.strip()
            if not raw or len(raw) > MAX_LINE:
                continue       # oversized: not a record this daemon wrote
            lines.append(raw)
        return lines[-MAX_HISTORY_RECORDS:]


def history_record(obj: dict) -> dict:
    """Keep only the fields the panel renders, at bounded sizes.

    The file is ours, but it is an ordinary user-writable file: a substituted
    history must not be able to hand the panel a megabyte-long "peer".
    """
    return {
        "ts": finite(obj.get("ts")),
        "direction": "in" if obj.get("direction") == "in" else "out",
        "peer": clip(obj.get("peer") or ""),
        "missed": obj.get("missed") is True,
        "duration": max(0, min(int(obj.get("duration") or 0), 7 * 86400)),
        "reason": clip(obj.get("reason") or ""),
        "end": finite(obj.get("end") or obj.get("ts")),
    }


def finite(value) -> float:
    """A timestamp from a user-writable file: a finite, non-negative float.
    NaN and Infinity parse as floats and print as bare words no JSON parser
    accepts, which would break the panel's reading of the whole document."""
    try:
        number = float(value or 0)
    except (TypeError, ValueError):
        return 0.0
    return number if math.isfinite(number) and number > 0 else 0.0


def read_history(limit: int) -> list[dict]:
    """Most recent first."""
    limit = max(0, min(int(limit), MAX_HISTORY_RECORDS))
    out: list[dict] = []
    if limit == 0:
        return out
    for line in reversed(CallTracker(conf_fd()).read_lines()):
        try:
            obj = json.loads(line)
            if not isinstance(obj, dict):
                continue
            out.append(history_record(obj))
        except (ValueError, TypeError):
            continue
        if len(out) >= limit:
            break
    return out


def clip_reply(reply: dict | None) -> dict | None:
    """Cap a baresip reply before it is spliced into the `status` snapshot.

    baresip answers in prose of its own choosing; the panel should never be
    handed an unbounded string just because a reply was long.
    """
    if not isinstance(reply, dict):
        return None
    out: dict = {}
    for key, value in list(reply.items())[:16]:
        out[clip(key, 64)] = clip(value, MAX_REPLY_CHARS) if isinstance(value, str) else value
    return out


class BaresipBus:
    """baresip's ctrl_dbus surface, driven from our own selectors loop.

    jeepney does the SASL EXTERNAL handshake and Hello for us and then hands
    back an ordinary socket, so the connection is just another descriptor in
    the daemon's poll set -- no GLib main loop, no reader thread, no helper
    process. Bytes go through jeepney's own parser; we never hand-roll the
    D-Bus wire format.

    Two things come back off the bus: `event` signals, whose third argument is
    the same JSON object ctrl_tcp used to emit and which we forward verbatim,
    and method returns for the `invoke` calls we made, which we match to the
    requesting client by serial.
    """

    def __init__(self) -> None:
        if open_dbus_connection is None:
            die("python-jeepney is not installed (omarchy pkg add python-jeepney)")
        self.addr = DBusAddress(DBUS_PATH, bus_name=DBUS_NAME, interface=DBUS_NAME)
        self.conn = open_dbus_connection(bus="SESSION")
        self.conn.sock.setblocking(False)
        self.pending: dict[int, str] = {}     # method-call serial -> client token
        blocking = self.conn.sock.gettimeout()
        self.conn.sock.setblocking(True)
        try:
            # Bind to the baresip we started, by its unique bus name. Any
            # session-bus client can emit a signal with baresip's interface
            # and path; without a sender, a forged `event` would be
            # forwarded to every panel as if baresip had said it.
            reply = self.conn.send_and_get_reply(message_bus.GetNameOwner(DBUS_NAME), timeout=5)
            self.owner = str(reply.body[0]) if reply.body else ""
            if not self.owner.startswith(":"):
                raise ConnectionError(f"{DBUS_NAME} has no owner")
            rule = MatchRule(type="signal", sender=self.owner, interface=DBUS_NAME, path=DBUS_PATH)
            self.conn.send_and_get_reply(message_bus.AddMatch(rule), timeout=5)
        finally:
            self.conn.sock.settimeout(blocking)
            self.conn.sock.setblocking(False)

    def fileno(self) -> int:
        return self.conn.sock.fileno()

    def invoke(self, line: str, token: str) -> None:
        """Ask baresip to run one command; the reply is matched back by serial.

        jeepney's send() does not hand back the serial it allocated, so take
        one from the connection's own counter and pass it in -- otherwise every
        reply arrives with a reply_serial that matches nothing and each command
        looks like a timeout.
        """
        msg = new_method_call(self.addr, "invoke", "s", (line,))
        serial = next(self.conn.outgoing_serial)
        if len(self.pending) < MAX_PENDING:
            self.pending[serial] = token
        try:
            self.conn.send(msg, serial=serial)
        except OSError:
            self.pending.pop(serial, None)
            raise

    def pump(self):
        """Drain the socket, yielding ("event", json) / ("reply", token, text).

        Returns instead of yielding when the peer is gone, which the daemon
        treats exactly as it treated a closed ctrl_tcp connection.
        """
        try:
            chunk = self.conn.sock.recv(65536)
        except BlockingIOError:
            return
        except OSError:
            chunk = b""
        if not chunk:
            raise ConnectionResetError("dbus connection closed")
        self.conn.parser.add_data(chunk)
        while True:
            msg = self.conn.parser.get_next_message()
            if msg is None:
                return
            mtype = msg.header.message_type
            sender = msg.header.fields.get(HEADER_SENDER)
            if mtype is MessageType.signal:
                if sender != self.owner:
                    continue      # not our baresip: the match rule should not let it through
                member = msg.header.fields.get(HEADER_MEMBER)
                if member == "event" and len(msg.body) >= 3:
                    yield ("event", str(msg.body[2]))
            elif mtype in (MessageType.method_return, MessageType.error):
                # From baresip, or the bus refusing on its behalf.
                if sender not in (self.owner, "org.freedesktop.DBus"):
                    continue
                reply_to = msg.header.fields.get(HEADER_REPLY_SERIAL)
                token = self.pending.pop(reply_to, None)
                if token is None:
                    continue
                ok = mtype is MessageType.method_return
                text = str(msg.body[0]) if msg.body else ""
                yield ("reply", token, text, ok)

    def close(self) -> None:
        try:
            self.conn.close()
        except OSError:
            pass


NOTIFY_NAME = "org.freedesktop.Notifications"
NOTIFY_PATH = "/org/freedesktop/Notifications"
MAX_NOTIFY_TEXT = 200


def notify_text(value) -> str:
    """Caller-controlled text made safe for a notification body.

    The notification server advertises body-markup, so a display name of
    `<a href=...>` would be rendered, not shown. Escape it, flatten it to one
    line, and clip it.
    """
    text = " ".join(str(value or "").split())
    if len(text) > MAX_NOTIFY_TEXT:
        text = text[: MAX_NOTIFY_TEXT - 1] + "…"
    return html.escape(text, quote=False)


class Notifier:
    """Desktop notifications, sent by the daemon on its own session-bus
    connection so they work while the shell is restarting, and exactly once
    however many monitors the bar spans.

    Notifications are addressed by a key of our choosing ("call:<id>",
    "reg"); the server's numeric ids are learnt from Notify's reply and
    mapped back. Nothing here can take the daemon down: a server that is
    missing (the shell is between restarts) or a connection that fails only
    means no notification.
    """

    def __init__(self) -> None:
        self.conn = None
        self.addr = DBusAddress(NOTIFY_PATH, bus_name=NOTIFY_NAME, interface=NOTIFY_NAME)
        self.pending: dict[int, str] = {}   # Notify serial -> key
        self.ids: dict[str, int] = {}       # key -> server id, of the current server
        self.close_on_reply: set[str] = set()
        # The notification server's unique bus name. Its signals are trusted
        # only from it -- any client can emit ActionInvoked -- and its ids
        # mean nothing once it is replaced: the Omarchy shell *is* the
        # server, and a restarted shell hands out the same small numbers to
        # other apps' notifications.
        self.owner: str | None = None
        self.on_close = None     # called with the descriptor number on close
        try:
            self.conn = open_dbus_connection(bus="SESSION")
            rule = MatchRule(type="signal", interface=NOTIFY_NAME, path=NOTIFY_PATH)
            self.conn.send_and_get_reply(message_bus.AddMatch(rule), timeout=5)
            owner_rule = MatchRule(type="signal", sender="org.freedesktop.DBus",
                                   interface="org.freedesktop.DBus", member="NameOwnerChanged",
                                   path="/org/freedesktop/DBus")
            owner_rule.add_arg_condition(0, NOTIFY_NAME)
            self.conn.send_and_get_reply(message_bus.AddMatch(owner_rule), timeout=5)
            try:
                reply = self.conn.send_and_get_reply(message_bus.GetNameOwner(NOTIFY_NAME), timeout=5)
                if reply.body and str(reply.body[0]).startswith(":"):
                    self.owner = str(reply.body[0])
            except Exception:
                pass      # no server right now (the shell restarting); learnt later
            self.conn.sock.setblocking(False)
        except Exception:
            self.close()

    MAX_IDS = 64

    def forget_server(self, owner: str | None) -> None:
        """A different server now: its ids are not ours."""
        self.ids.clear()
        self.close_on_reply.clear()
        self.owner = owner

    def fileno(self) -> int:
        return self.conn.sock.fileno() if self.conn else -1

    def _send(self, method: str, signature: str, body: tuple) -> int | None:
        if self.conn is None:
            return None
        msg = new_method_call(self.addr, method, signature, body)
        serial = next(self.conn.outgoing_serial)
        try:
            self.conn.send(msg, serial=serial)
        except BlockingIOError:
            return None       # the bus is backed up: drop this one, keep the connection
        except OSError:
            self.close()
            return None
        return serial

    def notify(self, key: str, summary: str, body: str, actions=(), urgency: int = 1,
               category: str = "", replace: bool = False) -> None:
        hints = {"urgency": ("y", urgency)}
        if category:
            hints["category"] = ("s", category)
        replaces = self.ids.get(key, 0) if replace else 0
        flat: list[str] = []
        for name, label in actions:
            flat += [name, label]
        serial = self._send("Notify", "susssasa{sv}i", (
            "Simple SIP", replaces, "call-start-symbolic", summary, body, flat, hints, -1,
        ))
        if serial is not None and len(self.pending) < MAX_PENDING:
            self.pending[serial] = key
        self.close_on_reply.discard(key)

    def close_key(self, key: str) -> None:
        nid = self.ids.pop(key, None)
        if nid is not None:
            self._send("CloseNotification", "u", (nid,))
        elif key in self.pending.values():
            self.close_on_reply.add(key)   # the reply with its id is still coming

    def pump(self):
        """Yield (key, action) for every action button pressed."""
        if self.conn is None:
            return
        try:
            chunk = self.conn.sock.recv(65536)
        except BlockingIOError:
            return
        except OSError:
            chunk = b""
        if not chunk:
            self.close()
            return
        self.conn.parser.add_data(chunk)
        while True:
            msg = self.conn.parser.get_next_message()
            if msg is None:
                return
            mtype = msg.header.message_type
            fields = msg.header.fields
            sender = fields.get(HEADER_SENDER)
            signature = fields.get(HEADER_SIGNATURE, "")
            member = fields.get(HEADER_MEMBER)
            if mtype in (MessageType.method_return, MessageType.error):
                key = self.pending.pop(fields.get(HEADER_REPLY_SERIAL), None)
                if key is None or mtype is MessageType.error or signature != "u":
                    continue
                if sender != self.owner:
                    self.forget_server(sender)     # whoever answered Notify is the server now
                if len(self.ids) >= self.MAX_IDS and key not in self.ids:
                    self.ids.pop(next(iter(self.ids)))
                self.ids[key] = int(msg.body[0])
                if key in self.close_on_reply:
                    self.close_on_reply.discard(key)
                    self.close_key(key)
            elif mtype is MessageType.signal:
                if member == "NameOwnerChanged" and sender == "org.freedesktop.DBus":
                    if signature == "sss" and msg.body[0] == NOTIFY_NAME:
                        self.forget_server(str(msg.body[2]) or None)
                    continue
                if sender is None or sender != self.owner:
                    continue      # anyone can emit these; only the server's count
                if member == "ActionInvoked" and signature == "us":
                    nid, action = int(msg.body[0]), str(msg.body[1])
                    for key, known in list(self.ids.items()):
                        if known == nid:
                            yield key, action
                elif member == "NotificationClosed" and signature == "uu":
                    nid = int(msg.body[0])
                    for key, known in list(self.ids.items()):
                        if known == nid:
                            del self.ids[key]

    def close(self) -> None:
        if self.conn is not None:
            try:
                fd = self.conn.sock.fileno()
            except OSError:
                fd = -1
            try:
                self.conn.close()
            except OSError:
                pass
            self.conn = None
            # Unregister now, not at the end of the loop iteration: a client
            # accepted later in the same pass could already reuse the number.
            if self.on_close is not None and fd >= 0:
                try:
                    self.on_close(fd)
                except (KeyError, ValueError):
                    pass
        self.conn = None


REG_ALERT_AFTER = 30.0   # seconds of lost registration before we say so

# A SIP Call-ID is chosen by whoever places the call, and `accept`/`hangup`/
# `hold`/`resume` take it as the first token of a command line (baresip's
# menu_get_call_ua: the first `[^ ]+`, refused if it contains `=`). RFC 3261
# allows most printable ASCII in one, so that is what is admitted -- minus
# space and `=`, which baresip itself cannot take, and `;`, quotes and
# backslash, which nothing here should ever pass along to a command line.
_CALL_ID_CHARS = "".join(chr(c) for c in range(0x21, 0x7F) if chr(c) not in " =;\"'\\")
CALL_ID = re.compile("[" + re.escape(_CALL_ID_CHARS) + "]{1,256}")
_CALL_ID_OPT = re.compile("(?:[" + re.escape(_CALL_ID_CHARS) + "]{1,256})?")


def call_id_ok(value: str) -> bool:
    return CALL_ID.fullmatch(str(value or "")) is not None


def dnd_reject(event: dict, options: dict, tracker, invoke) -> bool:
    """Turn an incoming call away under Do Not Disturb.

    480 Temporarily Unavailable, which a PBX normally answers by sending the
    caller to voicemail -- and unlike baresip's own `dnd`, which refuses the
    INVITE before any call exists, the call is still logged, as a miss with
    reason DND. Rejected by call id, never "the current call": a bare hangup
    could end a different call already in progress. Returns whether it did.
    """
    if event.get("type") != "CALL_INCOMING" or not options.get("dnd"):
        return False
    call_id = str(event.get("id") or "")
    if not call_id_ok(call_id):
        return False     # rings through, and is logged and notified as any call
    invoke(f"hangup {call_id} scode=480")
    tracker.mark_dnd(call_id)
    return True


class CallAlerts:
    """Decides what the daemon notifies, from baresip's own events.

    Pure logic over a notifier and `invoke`/`show` callbacks, so it runs
    under test with fakes. Clicking an incoming-call notification (the
    "default" action) asks the panel to open; Answer/Reject buttons act on
    baresip directly, for servers that draw them -- Omarchy's own server runs
    only the default action, on click. Answering closes the notification; a
    call that ends unanswered turns it into "Missed call". Registration that has been
    failing for REG_ALERT_AFTER seconds, after having worked, is reported
    once and withdrawn when it recovers.
    """

    def __init__(self, notifier, options, invoke, clock=time.monotonic, show=None,
                 contacts=None) -> None:
        self.notifier = notifier
        self.contacts = contacts or (lambda: [])   # callable -> [{name, uri}]
        self.options = options          # callable -> current options dict
        self.invoke = invoke            # callable(line) -> None
        self.show = show or (lambda: None)   # ask the panel to open
        self.clock = clock
        self.ringing: dict[str, str] = {}   # call id -> caller label
        self.answered: set[str] = set()
        self.quiet: set[str] = set()        # arrived under Do Not Disturb
        self.ever_registered = False
        self.lost_since: float | None = None
        self.reg_error = ""
        self.reg_alerted = False

    def caller(self, event: dict) -> str:
        address = peer_uri(event.get("peeruri") or "").partition(":")[2]
        try:
            aor = account_aor()
            domain = aor.partition("@")[2].split(";")[0] if "@" in aor else ""
            name = contact_name_for(event.get("peeruri") or "", self.contacts(), domain)
        except (OSError, SystemExit):
            name = ""
        if name and address:
            return f"{name} ({address})"
        return name or address or "unknown caller"

    def handle(self, event: dict, quiet: bool = False) -> None:
        """`quiet`: this call was turned away under Do Not Disturb, so it is
        not notified, now or when it closes."""
        etype = event.get("type")
        call_id = str(event.get("id") or "-")
        opts = self.options()
        if etype == "CALL_INCOMING":
            self.ringing[call_id] = self.caller(event)
            if quiet:
                self.quiet.add(call_id)
            elif opts.get("notifications"):
                self.notifier.notify(
                    f"call:{call_id}", "Incoming call", notify_text(self.ringing[call_id]),
                    actions=(("default", "Open"), ("answer", "Answer"), ("reject", "Reject")),
                    urgency=2, category="call.incoming",
                )
        elif etype in ("CALL_ANSWERED", "CALL_ESTABLISHED"):
            if call_id in self.ringing:
                self.answered.add(call_id)
                self.notifier.close_key(f"call:{call_id}")
        elif etype == "CALL_CLOSED":
            label = self.ringing.pop(call_id, None)
            answered = call_id in self.answered
            quiet = call_id in self.quiet
            self.answered.discard(call_id)
            self.quiet.discard(call_id)
            if label is None or quiet:
                return
            if not answered and opts.get("notifications"):
                self.notifier.notify(
                    f"call:{call_id}", "Missed call", notify_text(label),
                    urgency=1, category="call.unanswered", replace=True,
                )
            else:
                self.notifier.close_key(f"call:{call_id}")
        elif etype == "REGISTER_OK":
            self.ever_registered = True
            self.lost_since = None
            if self.reg_alerted:
                self.reg_alerted = False
                self.notifier.close_key("reg")
        elif etype == "REGISTER_FAIL":
            self.reg_error = str(event.get("param") or "")
            if self.ever_registered and self.lost_since is None:
                self.lost_since = self.clock()

    def tick(self) -> None:
        """Called from the daemon loop; raises the registration alert when due."""
        if self.lost_since is None or self.reg_alerted:
            return
        if self.clock() - self.lost_since < REG_ALERT_AFTER:
            return
        if not self.options().get("regAlerts"):
            return
        self.reg_alerted = True
        detail = f" ({notify_text(self.reg_error)})" if self.reg_error else ""
        self.notifier.notify(
            "reg", "SIP registration lost",
            f"Calls won't reach you until it recovers{detail}.", urgency=1,
        )

    def action(self, key: str, action: str) -> None:
        """A notification button, acting on that notification's own call --
        by id, never "the current call" -- and only while it is ringing."""
        call_id = key[5:] if key.startswith("call:") else ""
        if call_id not in self.ringing or call_id in self.answered:
            return
        if action in ("answer", "reject") and not call_id_ok(call_id):
            return       # cannot be named on a command line; the panel still can
        if action == "answer":
            self.invoke(f"accept {call_id}")
        elif action == "reject":
            self.invoke(f"hangup {call_id}")
        elif action == "default":
            self.show()


def bus_name_taken() -> bool:
    """Is another baresip already exporting the control interface?

    Two baresips cannot both own the well-known name, so the second one's
    ctrl_dbus silently fails to export while the process runs on regardless --
    the D-Bus equivalent of the stale-ctrl_tcp-instance problem.
    """
    if open_dbus_connection is None:
        return False
    try:
        conn = open_dbus_connection(bus="SESSION")
    except Exception:
        return False
    try:
        reply = conn.send_and_get_reply(message_bus.NameHasOwner(DBUS_NAME), timeout=2)
        return bool(reply.body and reply.body[0])
    except Exception:
        return False
    finally:
        conn.close()


def cap_baresip_log(log_fd: int, limit: int = MAX_BARESIP_LOG) -> None:
    """Truncate the log in place once it passes `limit`.

    `subprocess.Popen(stdout=log_fd)` dup2s this exact descriptor into the
    baresip child, so its fd and ours share one open file description --
    including its offset. `ftruncate` then `lseek` back to 0 rotates the file
    for both of us without either process reopening it by pathname; baresip's
    next write just lands at the front of the now-empty file. Called on the
    daemon's own poll tick, so nothing extra has to be scheduled. A registrar
    or a verbose SIP trace would otherwise grow this file -- tmpfs, so it is
    memory -- for as long as systemd keeps restarting the daemon, which can be
    weeks.
    """
    try:
        if os.fstat(log_fd).st_size > limit:
            os.ftruncate(log_fd, 0)
            os.lseek(log_fd, 0, os.SEEK_SET)
    except OSError:
        pass


def cmd_daemon(_args) -> int:
    if BARESIP is None:
        die("baresip is not installed (omarchy pkg add baresip)")
    if open_dbus_connection is None:
        die("python-jeepney is not installed (omarchy pkg add python-jeepney)")
    global _HUB
    ensure_config()
    rfd = run_fd()

    # Refuse to adopt somebody else's baresip: only one process can own the
    # well-known name, so a stale instance would leave our own baresip's
    # ctrl_dbus silently unexported while we drove theirs instead.
    if bus_name_taken():
        die(f"{DBUS_NAME} is already owned -- another baresip is running")

    for stale in ("cmd", "events"):
        try:
            os.unlink(stale, dir_fd=rfd)   # left by pre-socket versions
        except OSError:
            pass

    hub = _HUB = ControlHub(rfd)

    # Truncated per start rather than appended forever: this lives in the
    # runtime dir (tmpfs), so an unbounded log is an unbounded allocation. It
    # records peer URIs, so it is 0600 like the rest.
    write_private(BARESIP_LOG, "", rfd)
    log_fd = open_checked(BARESIP_LOG, os.O_WRONLY | os.O_APPEND, dir_fd=rfd)

    # Hand baresip the pinned directory rather than the name: it re-resolves
    # whatever it is given, and /proc/self/fd/N resolves through the inode we
    # already validated instead of a path another process can rearrange.
    cfd = conf_fd()
    os.set_inheritable(cfd, True)
    baresip = subprocess.Popen(
        [BARESIP, "-f", f"/proc/self/fd/{cfd}"],
        stdout=log_fd,
        stderr=subprocess.STDOUT,
        pass_fds=(cfd,),
        env=child_env(),
    )

    def shutdown(*_):
        baresip.terminate()
        hub.close()
        raise SystemExit(1)

    signal.signal(signal.SIGTERM, shutdown)
    signal.signal(signal.SIGINT, shutdown)

    bus = None
    for _ in range(100):
        if baresip.poll() is not None:
            die(f"baresip exited immediately -- see {RUN_DIR}/{BARESIP_LOG}")
        if bus_name_taken():
            bus = BaresipBus()
            break
        time.sleep(0.1)
    if bus is None:
        baresip.terminate()
        die(f"baresip did not export {DBUS_NAME} -- see {RUN_DIR}/{BARESIP_LOG}")

    # Greeting rather than a plain journal entry: the panel's event listener
    # reconnects throughout the daemon's life and needs this on every connect.
    hub.greet(json.dumps({"type": "CTRL_CONNECTED"}, separators=(",", ":")))

    options = read_options()
    hub.greet(json.dumps({"type": "OPTIONS", **options}, separators=(",", ":")))

    def local(name: str, params: str, token: str) -> None:
        nonlocal options
        if name == "reload-options":
            options = read_options()
            hub.greet(json.dumps({"type": "OPTIONS", **options}, separators=(",", ":")))
            if token:
                hub.broadcast(json.dumps({"response": True, "ok": True, "data": "", "token": token},
                                         separators=(",", ":")))
        elif name == "prefill":
            hub.broadcast(json.dumps({"type": "PREFILL", "target": params}, separators=(",", ":")))
            if token:
                hub.broadcast(json.dumps({"response": True, "ok": True, "data": "", "token": token},
                                         separators=(",", ":")))

    tracker = CallTracker(conf_fd())
    notifier = Notifier()
    alerts = CallAlerts(
        notifier, lambda: options, lambda line: bus.invoke(line, "notify"),
        show=lambda: hub.broadcast(json.dumps({"type": "SHOW_PANEL"}, separators=(",", ":"))),
        contacts=read_contacts,   # re-read per call: small, bounded, and edited while we run
    )
    sel = selectors.DefaultSelector()
    sel.register(bus.fileno(), selectors.EVENT_READ, "bus")
    sel.register(hub.sock, selectors.EVENT_READ, "listen")
    # The notifier can close itself from any call (a failed send in
    # alerts.handle, say); it unregisters itself as it does, since a stale
    # entry would collide with the next accepted client that reuses the
    # descriptor number and KeyError out of the loop.
    if notifier.fileno() >= 0:
        sel.register(notifier.fileno(), selectors.EVENT_READ, "notify")
        notifier.on_close = sel.unregister

    try:
        while True:
            if baresip.poll() is not None:
                journal({"type": "CTRL_FAILED", "reason": "baresip exited"})
                return 1
            for key, _ in sel.select(timeout=2.0):
                if key.data == "bus":
                    try:
                        items = list(bus.pump())
                    except (ConnectionResetError, OSError) as exc:
                        journal({"type": "CTRL_DISCONNECTED", "reason": str(exc)})
                        return 1
                    except Exception as exc:
                        # A message we cannot parse means the stream is no
                        # longer trustworthy; let systemd restart us rather
                        # than guess where the next one begins.
                        journal({"type": "CTRL_FAILED", "reason": f"bad message: {exc}"})
                        return 1
                    for item in items:
                        if item[0] == "event":
                            # baresip's own JSON, forwarded verbatim -- the
                            # same object ctrl_tcp used to emit, one per line.
                            # Safe because JSON escapes newlines.
                            text = item[1]
                            try:
                                event = json.loads(text)
                            except ValueError:
                                hub.broadcast(text)
                                continue
                            if not isinstance(event, dict):
                                hub.broadcast(text)
                                continue
                            tracker.handle(event)
                            # A call turned away under Do Not Disturb never
                            # reaches the panels: nothing there to ring, open or
                            # offer Answer for. Its CALL_CLOSED still does.
                            rejected = dnd_reject(event, options, tracker,
                                                  lambda line: bus.invoke(line, "dnd"))
                            if event.get("type") == "MWI_NOTIFY":
                                # state, not news: a panel that connects later needs it too
                                hub.greet(text, "MWI")
                            elif not rejected:
                                hub.broadcast(text)
                            alerts.handle(event, quiet=rejected)
                        else:
                            _, token, text, ok = item
                            hub.broadcast(json.dumps(
                                {"response": True, "ok": ok,
                                 "data": clip(text, MAX_REPLY_CHARS), "token": token},
                                separators=(",", ":"),
                            ))
                elif key.data == "notify":
                    try:
                        actions = list(notifier.pump())
                    except Exception:
                        # A message we cannot make sense of: no notifications
                        # rather than a daemon (and the call) going down.
                        notifier.close()
                        actions = []
                    for nkey, action in actions:
                        alerts.action(nkey, action)
                elif key.data == "listen":
                    conn = hub.accept()
                    if conn is not None:
                        sel.register(conn, selectors.EVENT_READ, "client")
                else:
                    conn = key.fileobj
                    for line in hub.read_commands(conn):
                        dispatch(bus, hub, line, local)
                    if conn not in hub.clients:
                        sel.unregister(conn)
            hub.flush_all()
            alerts.tick()
            cap_baresip_log(log_fd)
    finally:
        sel.close()
        notifier.close()
        bus.close()
        os.close(log_fd)
        hub.close()
        _HUB = None
        baresip.terminate()


# The only commands this plugin's own UI and CLI subcommands ever issue:
# dial/accept/hangup from the panel, reginfo/listcalls from status polling.
# `None` means the command takes no parameter at all; a regex means the
# parameter must match it exactly or the command is refused.
_COMMAND_GRAMMAR: dict[str, "re.Pattern[str] | None"] = {
    # No ';', '"', or whitespace: '!-~' (all printable ASCII) was the first
    # cut here and it was wrong -- ';' is printable, so `sip:a@b;<anything>`
    # matched it, which is exactly the smuggling this allowlist exists to
    # stop, and for the identical reason account_field() rejects ';' in every
    # account field. The characters below cover every target this plugin
    # itself ever builds (Model.normalizeTarget's output, plus feature codes
    # like *43) without admitting anything ctrl_dbus's command line could
    # read as a separator.
    "dial": re.compile(r"^sips?:[A-Za-z0-9._~:/@%+*#-]{1,250}$"),
    # Optionally naming the call, as the panel and notifications do.
    "accept": _CALL_ID_OPT,
    "hangup": _CALL_ID_OPT,
    "reginfo": None,
    "listcalls": None,
    # In-call controls from baresip's menu module, all on the current call.
    # mute takes an explicit state rather than toggling, so a command that
    # arrives twice cannot flip it back.
    "mute": re.compile(r"^(yes|no)$"),
    "hold": _CALL_ID_OPT,
    "resume": _CALL_ID_OPT,
    # DTMF: each character is sent as a digit, in order. Only what a keypad
    # has -- 0-9, *, # and the rarely-seen A-D.
    "sndcode": re.compile(r"^[0-9*#A-Da-d]{1,32}$"),
    # Blind transfer of the current call: same target grammar as dial.
    "transfer": re.compile(r"^sips?:[A-Za-z0-9._~:/@%+*#-]{1,250}$"),
}


# Commands the daemon answers itself; they never reach baresip. Same shape as
# _COMMAND_GRAMMAR, checked the same way.
# What a clicked link may put in the dial field: a phone number, or an
# address the dial grammar accepts.
PREFILL_TARGET = re.compile(r"^(\+?[0-9*#]{1,32}|sips?:[A-Za-z0-9._~:/@%+*#-]{1,250})$")

_LOCAL_GRAMMAR: dict[str, "re.Pattern[str] | None"] = {
    "reload-options": None,
    # A sip:/tel: link was opened: fill the panel's dial field. Never dials.
    "prefill": PREFILL_TARGET,
}


def dispatch(bus: "BaresipBus", hub: "ControlHub", line: bytes, local=None) -> None:
    """Turn one allowed client command line into a baresip `invoke`.

    The client protocol is unchanged from the ctrl_tcp days -- one JSON object
    per line with `command`, optional `params` and optional `token` -- because
    Service.qml and the `send`/`cmd` subcommands both speak it. ctrl_dbus's
    `invoke`, though, feeds its whole argument through baresip's own command
    line the same way typing at its interactive prompt would: a stray newline
    or `;` in a parameter is not cosmetic, it can end the command baresip
    thinks it is running and start a different one of the sender's choosing.
    The socket is already same-uid only, but a command name outside the small
    set this plugin actually needs, or a parameter that does not match that
    command's own grammar, is refused rather than forwarded -- narrowing what
    a confused or malicious same-uid caller can make baresip do through it,
    rather than trusting whatever arrives verbatim.
    """
    try:
        obj = json.loads(line)
    except ValueError:
        return
    if not isinstance(obj, dict):
        return
    name = str(obj.get("command") or "").strip()
    token = clip(obj.get("token") or "", 128)
    params = str(obj.get("params") or "").strip()

    is_local = name in _LOCAL_GRAMMAR
    if not is_local and name not in _COMMAND_GRAMMAR:
        allowed = False
    else:
        grammar = _LOCAL_GRAMMAR[name] if is_local else _COMMAND_GRAMMAR[name]
        allowed = (grammar is None and not params) or (
            grammar is not None and grammar.fullmatch(params) is not None)
    if allowed and is_local and local is None:
        allowed = False
    if not allowed:
        if token:
            hub.broadcast(json.dumps(
                {"response": True, "ok": False, "data": "command not permitted", "token": token},
                separators=(",", ":"),
            ))
        return
    if is_local:
        local(name, params, token)
        return
    bus.invoke(f"{name} {params}" if params else name, token)


def control_path() -> str:
    """Address the socket through the pinned runtime directory.

    /proc/self/fd/N resolves via the descriptor we already walked and validated,
    so connecting never re-traverses a pathname another process can rearrange.
    """
    return f"/proc/self/fd/{run_fd()}/{CONTROL}"


def connect_control(timeout: float = CONTROL_TIMEOUT) -> socket.socket:
    """Connect to the daemon, or die -- but never hang.

    There is no persistent object to validate here any more: a unix socket with
    nothing listening refuses the connect immediately (ECONNREFUSED) instead of
    blocking the way an unopened FIFO did, and a regular file or symlink in its
    place fails with ENOTSOCK/ECONNREFUSED rather than being written into.
    """
    conn = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    conn.settimeout(timeout)
    try:
        conn.connect(control_path())
    except OSError:
        conn.close()
        die("daemon is not running (omarchy-sip start)")
    return conn


def daemon_up() -> bool:
    """The socket only accepts connections while a daemon is listening."""
    conn = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    conn.settimeout(CONTROL_TIMEOUT)
    try:
        conn.connect(control_path())
        return True
    except OSError:
        return False
    finally:
        conn.close()


# ------------------------------------------------------------------ subcommands


def send_command(line: str, conn: socket.socket | None = None) -> None:
    """Hand one command line to the daemon."""
    if len(line) > MAX_LINE:
        die("command is too long")
    own = conn is None
    conn = conn or connect_control()
    try:
        conn.sendall((line + "\n").encode("utf-8"))
    except OSError as exc:
        die(f"could not reach the daemon: {exc}")
    finally:
        if own:
            conn.close()


def read_lines(conn: socket.socket, deadline: float | None = None):
    """Yield newline-delimited records from the daemon, bounded per record.

    A record longer than MAX_LINE is dropped and the stream resynchronises at
    the next newline, so nothing unbounded ever reaches a JSON parser -- this is
    the only thing standing between the daemon and the long-lived shell
    listener that consumes it.

    `deadline` is for the bounded readers (a command awaiting its response).
    Without one this is the panel's always-on event stream, and it must block:
    connect_control() leaves its 5s connect timeout on the socket, so failing
    to clear it here made `events` return -- and the caller exit 0 -- after the
    first five quiet seconds, taking the only path an incoming call has to the
    panel with it.
    """
    buf = b""
    dropping = False
    if deadline is None:
        conn.settimeout(None)
    while True:
        if deadline is not None:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                return
            conn.settimeout(remaining)
        try:
            chunk = conn.recv(65536)
        except (TimeoutError, socket.timeout):
            return
        except OSError:
            return
        if not chunk:
            return
        buf += chunk
        while b"\n" in buf:
            raw, _, buf = buf.partition(b"\n")
            if dropping:          # tail of a record we already dropped
                dropping = False
                continue
            if len(raw) > MAX_LINE:
                continue
            yield raw.decode("utf-8", "replace")
        if len(buf) > MAX_LINE:
            buf = b""
            dropping = True


def request(name: str, params: str | None = None, timeout: float = 5.0) -> dict | None:
    """Send a command and return the response object carrying our token.

    One connection for both directions, so the reply cannot be missed in the
    gap between sending and starting to listen.
    """
    token = f"cli-{os.getpid()}-{secrets.token_hex(4)}"
    deadline = time.monotonic() + timeout
    conn = connect_control(timeout)
    try:
        send_command(command_json(name, params, token), conn)
        for line in read_lines(conn, deadline):
            try:
                obj = json.loads(line)
            except ValueError:
                continue
            if isinstance(obj, dict) and obj.get("token") == token:
                return obj
        return None
    finally:
        conn.close()


def cmd_install(_args) -> int:
    ensure_config()
    write_unit()
    if systemctl("enable", "--now", UNIT) != 0:
        die(f"systemctl enable --now {UNIT} failed -- see: journalctl --user -u {UNIT}")
    print(f"omarchy-sip: installed and started ({UNIT})")
    if not account_aor():
        print("omarchy-sip: no account yet -- run: omarchy-sip account set sip:you@example.com")
    return 0


def cmd_uninstall(_args) -> int:
    systemctl("disable", "--now", UNIT)
    try:
        os.unlink(UNIT, dir_fd=unit_fd())
    except OSError:
        pass
    systemctl("daemon-reload")
    remove_handler()
    print(f"omarchy-sip: unit removed (config in {CONF_DIR} kept)")
    return 0


def cmd_start(_args) -> int:
    if not unit_installed():
        write_unit()
        if systemctl("enable", UNIT) != 0:
            die(f"systemctl enable {UNIT} failed")
    else:
        sync_unit()
    ensure_config()
    return systemctl("start", UNIT)


def cmd_stop(_args) -> int:
    return systemctl("stop", UNIT)


def cmd_restart(_args) -> int:
    sync_unit()
    ensure_config()
    return systemctl("restart", UNIT)


def cmd_send(args) -> int:
    token = getattr(args, "token", None) or "cli"
    token = token if TOKEN.fullmatch(token) else "cli"
    send_command(command_json(args.name, args.params, token))
    return 0


# A client's own reply token: the panel passes a random per-instance one, so a
# refusal of somebody else's command is never taken for a refusal of its own.
TOKEN = re.compile(r"[A-Za-z0-9-]{1,64}")


def cmd_cmd(args) -> int:
    reply = request(args.name, args.params)
    if reply is None:
        die(f"timed out waiting for a response to '{args.name}'")
    print(json.dumps(reply, separators=(",", ":")))
    return 0 if reply.get("ok") else 1


def cmd_events(_args) -> int:
    conn = connect_control()   # dies with the same message if nothing listens
    try:
        for line in read_lines(conn):
            print(line, flush=True)
    finally:
        conn.close()
    return 0


def parse_bool(value: str) -> bool:
    value = str(value or "").strip().lower()
    if value in ("on", "yes", "true", "1"):
        return True
    if value in ("off", "no", "false", "0"):
        return False
    die(f"expected on/off, got {value!r}")


def call_in_progress() -> bool:
    if not daemon_up():
        return False
    reply = request("listcalls", timeout=3)
    text = str((reply or {}).get("data") or "")
    match = re.search(r"Active calls \((\d+)\)", text)
    return bool(match and int(match.group(1)) > 0)


def cmd_option(args) -> int:
    options = read_options()
    if args.action == "show":
        print(json.dumps(options, separators=(",", ":")))
        return 0
    if args.key not in OPTION_DEFAULTS or args.value is None:
        die(f"usage: option set <{'|'.join(OPTION_DEFAULTS)}> <on|off>")
    value = parse_bool(args.value)
    changed = options[args.key] != value
    options[args.key] = value
    write_options(options)
    applied = True
    if daemon_up():
        # A round trip, so "on" is not printed for a daemon that refused the
        # reload (or is too old to know it).
        reply = request("reload-options", timeout=3)
        applied = bool(reply and reply.get("ok"))
    # Echo cancellation is a module in baresip's config, so it only takes
    # effect when baresip starts -- and restarting drops any call in progress.
    if args.key == "aec" and changed:
        ensure_config()
        if call_in_progress():
            print("omarchy-sip: echo cancellation takes effect after this call (restart the daemon then)")
        else:
            restart_if_live()
    if not applied:
        print(f"omarchy-sip: {args.key} saved as {'on' if value else 'off'}, but the daemon did not "
              "confirm it -- restart it: omarchy-sip restart", file=sys.stderr)
        return 1
    print(f"omarchy-sip: {args.key} {'on' if value else 'off'}")
    return 0


def read_seen() -> float:
    return finite(read_bounded(SEEN, conf_fd(), 64).strip())


def unseen_missed(seen: float) -> int:
    """Missed calls logged after `seen`, over the whole log, not just the
    rows the panel shows."""
    count = 0
    for record in read_history(MAX_HISTORY_RECORDS):
        if record["missed"] and record["end"] > seen:
            count += 1
    return count


def contact_name_field(value: str) -> str:
    """A name serialised into baresip's contacts grammar, where a `"` would
    end the quoted name and `<`/`>` would start a second address. None of
    them belongs in a name, so they are refused rather than escaped."""
    value = " ".join(str(value or "").split())
    if len(value) > MAX_CONTACT_NAME:
        die(f"contact name is too long (max {MAX_CONTACT_NAME} characters)")
    for ch in ('"', "<", ">", ";", "\\"):
        if ch in value:
            die(f"contact name cannot contain {ch!r}")
    return value


def cmd_contacts(args) -> int:
    fd = conf_fd()
    contacts = read_contacts(fd)
    if args.action == "list":
        print(json.dumps(contacts, separators=(",", ":")))
        return 0
    uri = sip_address(args.uri or "")
    if not uri:
        die("contacts needs a sip: address, e.g. sip:1001@pbx.example.com")
    name = contact_name_field(args.name or "") if args.action == "add" else ""
    if args.action == "add" and not name:
        die("contacts add needs --name")
    # Edit lines, never re-serialise the file: it is baresip's own, and
    # carries things this command does not model -- comments, tel: entries,
    # presence and, above all, `;access=block`, which is how baresip refuses
    # a caller. Only the line for this address changes; its parameters stay.
    text = read_exact(CONTACTS, fd, MAX_FILE) or ""
    lines = text.split("\n")
    if lines and lines[-1] == "":
        lines.pop()
    out, found = [], False
    for line in lines:
        stripped = line.strip()
        if not stripped or stripped.startswith("#") or sip_address(stripped) != uri:
            out.append(line)
            continue
        found = True
        if args.action == "add":
            tail = stripped.split(">", 1)[1] if ">" in stripped else ""
            out.append(contact_line({"name": name, "uri": uri}) + tail)
    if args.action == "add" and not found:
        if len(contacts) >= MAX_CONTACTS:
            die(f"at most {MAX_CONTACTS} contacts")
        out.append(contact_line({"name": name, "uri": uri}))
    if args.action == "remove" and not found:
        die(f"no contact for {uri}")
    write_private(CONTACTS, "".join(line + "\n" for line in out), fd)
    print(json.dumps(read_contacts(fd), separators=(",", ":")))
    return 0


def link_target(url: str) -> str:
    """What a sip:, sips: or tel: link should put in the dial field, or "".

    tel: is a phone number with visual separators (RFC 3966 allows - . ( ))
    and parameters such as ;phone-context; sip: may carry URI parameters and
    headers. The number or bare address is kept, the rest dropped, and the
    result must pass PREFILL_TARGET -- a link is text from anywhere.
    """
    value = urllib.parse.unquote(str(url or "").strip())
    if len(value) > 512:
        return ""
    scheme, sep, rest = value.partition(":")
    scheme = scheme.lower()
    if not sep or scheme not in HANDLER_SCHEMES:
        return ""
    if scheme == "tel":
        number = re.sub(r"[\s().-]", "", rest.split(";", 1)[0])
        target = number
    else:
        target = peer_uri(f"{scheme}:{rest.lstrip('/')}")
    # A PBX feature code (*72 forwarding, *67 caller-ID blocking, #...) is
    # not something a web page gets to put in front of a person, even for
    # them to confirm.
    user = target.partition(":")[2] if ":" in target else target
    if user.startswith(("*", "#")):
        return ""
    return target if PREFILL_TARGET.fullmatch(target) else ""


def cmd_open(args) -> int:
    target = link_target(args.url)
    if not target:
        die(f"not a sip:, sips: or tel: link this can dial: {args.url[:80]!r}")
    if not daemon_up():
        die("the SIP daemon is not running -- start it from the panel first")
    # A round trip rather than fire-and-forget, so a daemon too old to know
    # `prefill` says so instead of the link silently doing nothing.
    reply = request("prefill", target, timeout=3)
    if not reply or not reply.get("ok"):
        die("the daemon did not accept the link -- restart it: omarchy-sip restart")
    return 0


def apps_fd() -> int:
    """~/.local/share/applications: pinned, never re-moded -- it is not ours."""
    return dir_fd_for(APPS_DIR, 0o755, owned=False)


def handler_text() -> str:
    # Absolute, isolated interpreter, like the unit. Exec is unescaped twice
    # (key-file backslashes, then exec quoting), `%` is a field code, and a
    # CR or LF would end the key; a path carrying any of those, or one that
    # is not valid UTF-8, is refused rather than escaped twice over.
    for path in (PYTHON, SELF):
        if re.search(r'["\\$`%\r\n]', path):
            die(f"cannot write a desktop entry for this path: {path!r}")
        try:
            path.encode("utf-8")
        except UnicodeEncodeError:
            die("cannot write a desktop entry for a path that is not UTF-8")

    def quote(arg: str) -> str:
        return f'"{arg}"'
    return (
        "[Desktop Entry]\n"
        "Type=Application\n"
        "Name=Simple SIP\n"
        "Comment=Open sip: and tel: links in the Simple SIP panel\n"
        f"Exec={quote(PYTHON)} -I {quote(SELF)} open %u\n"
        "MimeType=" + "".join(f"x-scheme-handler/{s};" for s in HANDLER_SCHEMES) + "\n"
        "NoDisplay=true\n"
        "Terminal=false\n"
    )


# ~/.config/mimeapps.list is edited here rather than by running xdg-mime: that
# is a shell script which resolves the file through realpath, `touch`es it and
# rewrites it with `awk > file.new && mv` -- by pathname, following links and
# truncating in place, which is everything the rest of this helper refuses to
# do with a file the user owns. Only the [Default Applications] lines for our
# three schemes are touched; every other byte is kept.
MAX_MIMEAPPS = 256 * 1024
_SCHEME_KEYS = tuple(f"x-scheme-handler/{s}" for s in HANDLER_SCHEMES)


def edit_mimeapps(text: str, install: bool) -> str:
    """`text` with our scheme defaults set (install) or removed (uninstall).

    Values are ;-separated lists of desktop ids. Installing puts ours first
    and keeps the rest as fallbacks; uninstalling removes only ours.
    """
    lines = text.split("\n")
    if lines and lines[-1] == "":
        lines.pop()
    section = None
    start = end = None
    for i, line in enumerate(lines):
        stripped = line.strip()
        if stripped.startswith("[") and stripped.endswith("]"):
            if section == "[Default Applications]":
                end = i
            section = stripped
            if section == "[Default Applications]" and start is None:
                start = i
    if start is not None and end is None:
        end = len(lines)
    if start is None:
        if not install:
            return text
        if lines and lines[-1].strip():
            lines.append("")
        lines.append("[Default Applications]")
        start = end = len(lines) - 1
        end += 1
    body = lines[start + 1 : end]
    seen = set()
    out = []
    for line in body:
        key, sep, value = line.partition("=")
        key = key.strip()
        if sep and key in _SCHEME_KEYS:
            seen.add(key)
            ids = [v.strip() for v in value.split(";") if v.strip() and v.strip() != HANDLER]
            if install:
                ids.insert(0, HANDLER)
            if ids:
                out.append(f"{key}={';'.join(ids)};")
            continue
        out.append(line)
    if install:
        for key in _SCHEME_KEYS:
            if key not in seen:
                out.append(f"{key}={HANDLER};")
    lines[start + 1 : end] = out
    return "\n".join(lines) + "\n"


def update_mimeapps(install: bool) -> None:
    config = os.environ.get("XDG_CONFIG_HOME") or MIMEAPPS_DIR
    if not os.path.isabs(config):
        config = MIMEAPPS_DIR
    fd = dir_fd_for(config, 0o755, owned=False)
    lines = "\n".join(f"  {k}={HANDLER};" for k in _SCHEME_KEYS)
    manual = f"add these under [Default Applications] in {config}/{MIMEAPPS} yourself:\n{lines}"
    mode = 0o644
    try:
        rfd = open_checked(MIMEAPPS, os.O_RDONLY, dir_fd=fd)
    except FileNotFoundError:
        text = ""
    except OSError as exc:
        # Most often a dotfiles symlink: not ours to follow or replace.
        die(f"not editing {config}/{MIMEAPPS} ({exc.strerror or exc}) -- {manual}")
    else:
        try:
            st = os.fstat(rfd)
            mode = stat.S_IMODE(st.st_mode) & 0o644 or 0o644
            data = os.read(rfd, MAX_MIMEAPPS + 1)
        finally:
            os.close(rfd)
        if len(data) > MAX_MIMEAPPS:
            die(f"{config}/{MIMEAPPS} is larger than expected -- {manual}")
        text = data.decode("utf-8", "strict") if data else ""
    edited = edit_mimeapps(text, install)
    if edited != text:
        write_file(MIMEAPPS, edited, fd, mode)


def remove_handler() -> bool:
    """Take the desktop entry and our mimeapps defaults away. Never creates a
    directory just to find nothing in it, and never dies half-way: uninstall
    calls this after the unit is already gone."""
    removed = False
    if os.path.isdir(APPS_DIR) and not os.path.islink(APPS_DIR):
        try:
            os.unlink(HANDLER, dir_fd=apps_fd())
            removed = True
        except (OSError, SystemExit):
            pass
    try:
        update_mimeapps(install=False)
    except (OSError, SystemExit, UnicodeDecodeError):
        pass
    return removed


def cmd_handler(args) -> int:
    if args.action == "install":
        write_file(HANDLER, handler_text(), apps_fd(), 0o644)
        try:
            update_mimeapps(install=True)
        except UnicodeDecodeError:
            die("mimeapps.list is not UTF-8 -- not editing it")
        print(f"omarchy-sip: {', '.join(s + ':' for s in HANDLER_SCHEMES)} links now open the panel")
    else:
        removed = remove_handler()
        print("omarchy-sip: link handler removed" if removed else "omarchy-sip: no link handler installed")
    return 0


def cmd_history(args) -> int:
    if args.mark_seen:
        write_private(SEEN, f"{time.time():.3f}\n", conf_fd())
    seen = read_seen()
    print(json.dumps({
        "calls": read_history(args.limit),
        "unseenMissed": unseen_missed(seen),
        "seenTs": seen,
    }, separators=(",", ":"), allow_nan=False))
    return 0


def cmd_status(_args) -> int:
    up = daemon_up()
    aor = account_aor()
    snapshot = {
        "installed": unit_installed(),
        "unitActive": systemctl("is-active", "--quiet", UNIT) == 0,
        "daemonUp": up,
        "configured": bool(aor),
        "aor": aor,
        # Raw baresip responses, spliced in as objects so the consumer needs a
        # single parse. Pulling state out of the prose is Model.js's job.
        "reginfo": clip_reply(request("reginfo", timeout=3)) if up else None,
        "calls": clip_reply(request("listcalls", timeout=3)) if up else None,
        "options": read_options(),
    }
    print(json.dumps(snapshot, separators=(",", ":")))
    return 0


def restart_if_live() -> None:
    """Bounce the daemon only if we edited the config dir the unit actually reads."""
    if CONF_DIR == DEFAULT_CONF_DIR and unit_installed():
        systemctl("restart", UNIT)


MAX_PASSWORD_BYTES = 4096   # far larger than any real password -- a ceiling


def read_password_from_stdin(timeout: float = 5.0, limit: int = MAX_PASSWORD_BYTES) -> str:
    """Read the password from stdin, but never block forever or grow unbounded.

    The panel writes the password to this process's stdin and then closes the
    pipe. If a caller ever writes without closing, a plain readline() would
    hang the process (and the panel's form with it), so wait on the descriptor
    and give up with an empty password instead. The deadline alone is not a
    memory bound, though -- a writer that keeps the pipe open and keeps
    sending could allocate for the full five seconds at whatever rate the
    kernel will move bytes through a local pipe. `limit` stops that
    independently of how much time is left.
    """
    if sys.stdin.isatty():
        return ""
    fd = sys.stdin.fileno()
    deadline = time.monotonic() + timeout
    buf = b""
    while True:
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            break
        if not select.select([fd], [], [], remaining)[0]:
            break
        chunk = os.read(fd, 4096)
        if not chunk:       # writer closed the pipe
            break
        buf += chunk
        if len(buf) > limit:
            buf = buf[:limit]
            break
        if b"\n" in buf:    # a complete line is all we need
            break
    return buf.split(b"\n", 1)[0].decode("utf-8", "replace")


MAX_ACCOUNT_FIELD = 256   # display name / auth user / URI / outbound proxy / password

# baresip's accounts file is one line per account: fields are ';'-delimited,
# some quoted with '"'. A value that reaches here already carries meaning to
# that grammar -- '\r' or '\n' would start a second, attacker-chosen account
# line; ';' would close the current field early and open one of the caller's
# choosing (auth_pass, answermode, regint, ...); '"' would break out of a
# quoted field. None of the five fields collected here has a legitimate use
# for any of the three, so they are rejected outright rather than escaped --
# escaping this grammar correctly is more surface than these fields are worth.
def account_field(name: str, value: str, limit: int = MAX_ACCOUNT_FIELD) -> str:
    if len(value) > limit:
        die(f"{name} is too long (max {limit} characters)")
    for ch in ("\r", "\n", ";", '"'):
        if ch in value:
            die(f"{name} cannot contain {ch!r}")
    return value


# A registrable address of record: sip:user@host, optionally :port. baresip
# refuses an account whose URI has no user part ("module account.so: Invalid
# argument") and then registers nothing at all -- the daemon runs, the panel
# says "Starting…", and no call ever arrives -- so it is refused here instead,
# where the person saving it can be told why.
ACCOUNT_URI = re.compile(r"^sip:[^@\s;\"<>]+@[^@\s;\"<>]+$")


def account_details() -> dict:
    """What `account show` reports: everything the form edits except the
    password, whose presence alone is reported."""
    entry = account_entry()
    if entry is None:
        return {"configured": False, "aor": ""}
    params = entry["params"]
    regint = params.get("regint", "")
    return {
        "configured": bool(entry["uri"]),
        "aor": entry["uri"],
        "displayName": entry["display"],
        "authUser": params.get("auth_user", ""),
        "transport": account_transport(),
        "outbound": params.get("outbound", ""),
        "regint": int(regint) if regint.isdigit() else None,
        "hasPassword": bool(params.get("auth_pass", "")),
    }


def cmd_account(args) -> int:
    accounts = os.path.join(CONF_DIR, ACCOUNTS)   # display only; opens go via conf_fd()
    if args.action == "show":
        details = account_details()
        details["accountsFile"] = accounts
        print(json.dumps(details, separators=(",", ":")))
        return 0

    if args.action == "clear":
        write_private(ACCOUNTS, "", conf_fd())
        restart_if_live()
        print("omarchy-sip: account cleared")
        return 0

    # set. With --merge, any field not supplied keeps its current value --
    # above all the password, which the panel's form never shows and so can
    # only ever leave blank. Without it, a form opened to change the
    # transport would have saved an account with no password at all.
    current = account_entry() if args.merge else None
    params = current["params"] if current else {}

    def pick(given, key):
        return given if given is not None else params.get(key, "")

    uri = account_field("account URI", args.uri or (current["uri"] if current else ""))
    if not ACCOUNT_URI.match(uri):
        die("account set needs a sip:user@host URI, e.g. sip:1001@pbx.example.com")
    auth_user = account_field("auth user", pick(args.auth_user, "auth_user"))
    display_name = account_field(
        "display name",
        args.display_name if args.display_name is not None else (current["display"] if current else ""),
    )
    outbound = account_field("outbound proxy", pick(args.outbound, "outbound"))
    password = account_field("password", read_password_from_stdin())
    if not password and current:
        password = account_field("password", params.get("auth_pass", ""))
    transport = args.transport or (account_transport() if current else "udp")
    # Fields this command does not manage -- mediaenc, medianat, stunserver,
    # sipnat, a custom audio_codecs, ... -- are carried through verbatim, so
    # saving the form never quietly drops, say, mandatory SRTP. They come
    # from the file as whole `key=value` segments, which the line was split
    # on `;` to get, so they cannot contain one; a CR would end the line.
    managed = {"auth_user", "auth_pass", "transport", "outbound", "answermode", "regint"}
    extras = []
    if current:
        for field in current.get("raw", []):
            key = field.partition("=")[0].strip()
            if key in managed or "\r" in field or "\n" in field:
                continue
            if len(field) > MAX_ACCOUNT_FIELD * 2:
                die(f"the stored account's {key!r} field is too long to carry over")
            extras.append(field)
    regint = args.regint
    if regint is None:
        kept = params.get("regint", "")
        regint = int(kept) if kept.isdigit() else 600
    if not 0 <= regint <= 86400:
        die("regint must be between 0 and 86400 seconds")

    entry = f'"{display_name}" ' if display_name else ""
    entry += f"<{uri}>"
    if auth_user:
        entry += f";auth_user={auth_user}"
    if password:
        entry += f";auth_pass={password}"
    entry += f";transport={transport}"
    if outbound:
        entry += f';outbound="{outbound}"'
    entry += f";answermode=manual;regint={regint}"
    if not any(f.partition("=")[0].strip() == "audio_codecs" for f in extras):
        entry += ";audio_codecs=opus/48000/2,PCMU/8000/1,PCMA/8000/1"
    entry += "".join(";" + f for f in extras)

    # Accounts first: ensure_config() derives sip_transports from it, so
    # generating the config before the write would bake in the old transport.
    write_private(ACCOUNTS, entry + "\n", conf_fd())
    ensure_config()
    print(f"omarchy-sip: account set to {uri}")
    restart_if_live()
    return 0


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(
        prog="omarchy-sip", description="Simple SIP control surface"
    )
    sub = parser.add_subparsers(dest="sub", required=True)

    for name, fn, help_text in [
        ("daemon", cmd_daemon, "run the bridge in the foreground (used by the unit)"),
        ("install", cmd_install, "generate config, install and start the user service"),
        ("uninstall", cmd_uninstall, "stop and remove the user service (config kept)"),
        ("start", cmd_start, "start the daemon"),
        ("stop", cmd_stop, "stop the daemon"),
        ("restart", cmd_restart, "restart the daemon"),
        ("status", cmd_status, "JSON snapshot of unit, account and baresip state"),
        ("events", cmd_events, "stream the JSON event journal"),
    ]:
        sub.add_parser(name, help=help_text).set_defaults(func=fn)

    for name, fn, help_text in [
        ("send", cmd_send, "fire-and-forget baresip command"),
        ("cmd", cmd_cmd, "send a command and print the matching response"),
    ]:
        p = sub.add_parser(name, help=help_text)
        p.add_argument("name")
        p.add_argument("params", nargs="?")
        if name == "send":
            p.add_argument("--token", default="cli", help="reply token (the panel's own)")
        p.set_defaults(func=fn)

    p = sub.add_parser("history", help="recent calls as JSON, most recent first")
    p.add_argument("--limit", type=int, default=10)
    p.add_argument("--mark-seen", action="store_true",
                   help="record that the log has been looked at (clears the missed-call count)")
    p.set_defaults(func=cmd_history)

    p = sub.add_parser("contacts", help="list, add or remove contacts")
    p.add_argument("action", choices=["list", "add", "remove"], nargs="?", default="list")
    p.add_argument("uri", nargs="?")
    p.add_argument("--name")
    p.set_defaults(func=cmd_contacts)

    p = sub.add_parser("open", help="put a sip:/sips:/tel: link in the panel's dial field")
    p.add_argument("url")
    p.set_defaults(func=cmd_open)

    p = sub.add_parser("handler", help="make sip:/sips:/tel: links open the panel, or stop")
    p.add_argument("action", choices=["install", "uninstall"])
    p.set_defaults(func=cmd_handler)

    p = sub.add_parser("option", help="show or set the daemon's own options")
    p.add_argument("action", choices=["show", "set"], nargs="?", default="show")
    p.add_argument("key", nargs="?")
    p.add_argument("value", nargs="?")
    p.set_defaults(func=cmd_option)

    p = sub.add_parser("dial", help="place a call")
    p.add_argument("uri")
    p.set_defaults(func=lambda a: cmd_send(argparse.Namespace(name="dial", params=a.uri)))

    p = sub.add_parser("answer", help="accept the ringing call")
    p.set_defaults(func=lambda a: cmd_send(argparse.Namespace(name="accept", params=None)))

    p = sub.add_parser("hangup", help="end the current call")
    p.set_defaults(func=lambda a: cmd_send(argparse.Namespace(name="hangup", params=None)))

    p = sub.add_parser("account", help="show or set the SIP account")
    p.add_argument("action", choices=["show", "set", "clear"], nargs="?", default="show")
    p.add_argument("uri", nargs="?")
    p.add_argument("--auth-user")
    p.add_argument("--display-name")
    p.add_argument("--transport", choices=["udp", "tcp", "tls"],
                   help="default: udp, or the current transport with --merge")
    p.add_argument("--outbound")
    p.add_argument("--regint", type=int, help="default: 600, or the current value with --merge")
    p.add_argument("--merge", action="store_true",
                   help="keep the current value of every field not given, including the password")
    p.set_defaults(func=cmd_account)

    args = parser.parse_args(argv)
    return args.func(args) or 0


if __name__ == "__main__":
    try:
        raise SystemExit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        raise SystemExit(130)
