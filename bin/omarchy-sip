#!/usr/bin/python3 -I
"""omarchy-sip -- control surface for the Simple SIP Omarchy plugin.

baresip does all the SIP/RTP/audio work. This script drives it over the session
D-Bus (baresip's ctrl_dbus module) and re-exports that control surface on one
unix socket, which is what the QML panel, a terminal and a keybind all talk to:

    $XDG_RUNTIME_DIR/omarchy-sip/control

Clients connect, write one JSON command per line, and read the event stream
back the same way: every baresip event and every command response is broadcast
to every connected client, so a reader sees the whole picture. `send` is
fire-and-forget (what the panel uses); `cmd` sends and waits for the reply
carrying its token.

D-Bus rather than ctrl_tcp is deliberate, and not negotiable. ctrl_tcp listens
on a TCP port on loopback with no authentication, which is reachable by every
*other user* on the machine, and its connect handler drops the existing client
whenever a new one arrives -- so any local process could evict this daemon and
take over the registered SIP account without racing anything. The session bus
is peer-credential isolated: its socket lives in $XDG_RUNTIME_DIR (mode 0700,
unreachable across uids) and dbus-daemon authenticates every client with
SO_PEERCRED via EXTERNAL auth. The plugin's own socket checks SO_PEERCRED too.

A socket rather than a FIFO plus an on-disk journal is deliberate. Nothing
persistent has to be reopened by name to move a message, which removes the
substitution and truncation races that come with re-resolving a pathname in a
directory other local processes can write to.

Everything this process *does* keep on disk lives inside a directory pinned
once as a descriptor (see pin_dir) and is opened relative to it.

"""

from __future__ import annotations

import argparse
import errno
import html
import json
import math
import os
import re
import secrets
import select
import selectors
import signal
import socket
import stat
import struct
import subprocess
import sys
import time
import urllib.parse

try:
    from jeepney import DBusAddress, MatchRule, MessageType, new_method_call
    from jeepney.bus_messages import message_bus
    from jeepney.io.blocking import open_dbus_connection
    from jeepney.low_level import HeaderFields
    HEADER_MEMBER = HeaderFields.member
    HEADER_REPLY_SERIAL = HeaderFields.reply_serial
    HEADER_SENDER = HeaderFields.sender
    HEADER_SIGNATURE = HeaderFields.signature
except ImportError:   # reported properly by cmd_daemon; the CLI still runs
    open_dbus_connection = None

# baresip's ctrl_dbus module. The session bus, never the system bus: the system
# bus is shared across every user on the machine, which is the exact property
# that made ctrl_tcp unacceptable.
DBUS_NAME = "com.github.Baresip"
DBUS_PATH = "/baresip"

# Ephemeral by default: a registrar delivers inbound calls to the contact
# address we registered from, so no fixed port is needed and nothing can
# collide. Override for a direct-IP setup or a PBX that wants a known port.
SIP_LISTEN = os.environ.get("OMARCHY_SIP_LISTEN", "0.0.0.0:0")

# Optional: pin SIP to one interface. baresip otherwise opens a listener on
# *every* address it can see -- including docker0, bridges, veths and
# tailscale0, none of which have any business carrying SIP. Binding one
# interface takes this machine from 13 listeners to 4, but it defeats netroam:
# move between wifi and ethernet and calls stop arriving until it is changed.
# So it is opt-in rather than the default. Empty means "all interfaces".
SIP_INTERFACE = os.environ.get("OMARCHY_SIP_INTERFACE", "").strip()

HOME = os.path.expanduser("~")
DEFAULT_CONF_DIR = os.path.join(HOME, ".config/omarchy-sip")
CONF_DIR = os.environ.get("OMARCHY_SIP_CONF", DEFAULT_CONF_DIR)
RUN_DIR = os.path.join(
    os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}"), "omarchy-sip"
)
UNIT_DIR = os.path.join(HOME, ".config/systemd/user")
APPS_DIR = os.path.join(HOME, ".local/share/applications")
MIMEAPPS_DIR = os.path.join(HOME, ".config")
MIMEAPPS = "mimeapps.list"
HANDLER = "omarchy-sip-handler.desktop"
HANDLER_SCHEMES = ("sip", "sips", "tel")

# Basenames, not paths: every one of these is opened relative to the descriptor
# of the directory that holds it, so the full pathname is never re-resolved.
ACCOUNTS = "accounts"
CONTACTS = "contacts"
CONFIG = "config"
RINGTONE = "ring.wav"
HISTORY = "history.jsonl"
OPTIONS = "options.json"
SEEN = "seen"            # when the call log was last looked at
BARESIP_LOG = "baresip.log"
CONTROL = "control"
UNIT = "omarchy-sip.service"

SELF = os.path.abspath(__file__)

# Absolute paths to the distro binaries, never bare names resolved through
# PATH. Everything here runs inside a long-lived shell process whose
# environment this plugin does not control: a writable PATH entry, or
# PYTHONPATH/PYTHONHOME/LD_PRELOAD, would otherwise decide which interpreter
# and which `systemctl`/`baresip` the credential-bearing daemon actually runs.
# The shebang is `/usr/bin/python3 -I` for the same reason -- absolute, and
# isolated so PYTHON* variables and the user site directory are ignored.
# Resolved from a fixed list of root-owned system directories, never from
# $PATH. The list is the same one CHILD_PATH hands to children, so a baresip
# built into /usr/local/bin still works -- what is excluded is a caller's own
# PATH deciding which binary this runs.
TRUSTED_BIN_DIRS = ("/usr/local/bin", "/usr/bin", "/bin")


def trusted_bin(name: str) -> str | None:
    """First executable `name` in a trusted directory, or None."""
    for directory in TRUSTED_BIN_DIRS:
        candidate = os.path.join(directory, name)
        if os.path.isfile(candidate) and os.access(candidate, os.X_OK):
            return candidate
    return None


PYTHON = trusted_bin("python3") or sys.executable
SYSTEMCTL = trusted_bin("systemctl") or "/usr/bin/systemctl"
BARESIP = trusted_bin("baresip")

# ------------------------------------------------------------------- ceilings
#
# Everything this process reads back -- its own journal, its own history, the
# accounts file, baresip's replies -- lives in a directory another local
# process could try to substitute. None of it is trusted to be small, so every
# read is bounded and every persistent object is opened through a descriptor we
# then validate, rather than trusted by pathname alone.
MAX_LINE = 64 * 1024            # one event record / one command line
MAX_FILE = 1 << 20              # any state or config file we read whole
MAX_ACCOUNTS_FILE = 64 * 1024   # the accounts file is a handful of lines
MAX_FIELD = 512                 # one string field kept from a history record
MAX_HISTORY_RECORDS = 200       # records parsed out of history.jsonl
MAX_REPLY_CHARS = 8 * 1024      # baresip prose spliced into `status`
CONTROL_TIMEOUT = 5.0           # seconds allowed to hand a command to the daemon
MAX_CLIENTS = 16                # concurrent control-socket clients
MAX_PENDING = 64                # in-flight `invoke` calls awaiting a reply
MAX_BARESIP_LOG = 1 << 20       # baresip's own stdout/stderr, capped in place

# The ring the panel plays for an inbound call. baresip ships a ring.wav that is
# a recording of a voice announcing that the phone is ringing, which is not what
# a phone sounds like; this is the classic double-ring instead -- two 400+450 Hz
# bursts a fifth of a second apart, then a two-second pause, which baresip loops
# for as long as the call rings.
RING_RATE = 8000                # what the alert player already opens pulse at
RING_TONES = (400.0, 450.0)
RING_LEVEL = 0.4                # of full scale, summed -- audible, not startling
RING_FADE = 0.005               # 5ms in/out, so a burst has no click on it
RING_CADENCE = ((0.4, True), (0.2, False), (0.4, True), (2.0, False))


def ringtone_wav(rate: int = RING_RATE, cadence=RING_CADENCE,
                 tones=RING_TONES, level: float = RING_LEVEL) -> bytes:
    """Render the ring as a 16-bit mono PCM WAV.

    Generated rather than shipped: no binary asset in the plugin, nothing to
    convert at install time, and the cadence stays readable as the constants
    above. 16-bit PCM is what libre's aufile reader is built around, and mono
    at RING_RATE is exactly what audio_alert already opens.
    """
    fade = max(1, int(RING_FADE * rate))
    samples: list[int] = []
    for seconds, ringing in cadence:
        length = int(seconds * rate)
        if not ringing:
            samples.extend([0] * length)
            continue
        for i in range(length):
            value = sum(math.sin(2 * math.pi * hz * i / rate) for hz in tones)
            # Ramp in over the first `fade` samples and out over the last.
            envelope = min(1.0, (i + 1) / fade, (length - i) / fade)
            scaled = value / len(tones) * level * envelope
            samples.append(int(max(-1.0, min(1.0, scaled)) * 32767))

    body = struct.pack(f"<{len(samples)}h", *samples)
    return b"".join((
        b"RIFF", struct.pack("<I", 36 + len(body)), b"WAVE",
        b"fmt ", struct.pack("<IHHIIHH", 16, 1, 1, rate, rate * 2, 2, 16),
        b"data", struct.pack("<I", len(body)), body,
    ))


