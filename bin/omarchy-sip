#!/usr/bin/env python3
"""omarchy-sip -- control surface for the Simple SIP Omarchy plugin.

baresip does all the SIP/RTP/audio work. This script owns the one thing
baresip's ctrl_tcp module allows: a SINGLE control connection (the module's
connect handler drops any existing client when a new one arrives). Everything
else -- the QML panel, a terminal, a keybind -- reaches baresip through:

    $XDG_RUNTIME_DIR/omarchy-sip/cmd      FIFO, one JSON command per line
    $XDG_RUNTIME_DIR/omarchy-sip/events   append-only, one JSON object per line

Both baresip events and command responses land in the journal, so a reader
tailing it sees the whole picture. `send` is fire-and-forget (what the panel
uses); `cmd` sends and waits for the reply carrying its token.

The ctrl_tcp wire format is netstrings: <byte-length>:<json>,
"""

from __future__ import annotations

import argparse
import errno
import json
import os
import select
import selectors
import shutil
import signal
import socket
import stat
import subprocess
import sys
import time

CTRL_HOST = "127.0.0.1"
CTRL_PORT = 44510

# Ephemeral by default: a registrar delivers inbound calls to the contact
# address we registered from, so no fixed port is needed and nothing can
# collide. Override for a direct-IP setup or a PBX that wants a known port.
SIP_LISTEN = os.environ.get("OMARCHY_SIP_LISTEN", "0.0.0.0:0")

HOME = os.path.expanduser("~")
DEFAULT_CONF_DIR = os.path.join(HOME, ".config/omarchy-sip")
CONF_DIR = os.environ.get("OMARCHY_SIP_CONF", DEFAULT_CONF_DIR)
RUN_DIR = os.path.join(
    os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}"), "omarchy-sip"
)
FIFO = os.path.join(RUN_DIR, "cmd")
EVENTS = os.path.join(RUN_DIR, "events")
BARESIP_LOG = os.path.join(RUN_DIR, "baresip.log")

UNIT = "omarchy-sip.service"
UNIT_FILE = os.path.join(HOME, ".config/systemd/user", UNIT)
SELF = os.path.abspath(__file__)

# ------------------------------------------------------------------- ceilings
#
# Everything this process reads back -- its own journal, its own history, the
# accounts file, baresip's replies -- lives in a directory another local
# process could try to substitute. None of it is trusted to be small, so every
# read is bounded and every persistent object is opened through a descriptor we
# then validate, rather than trusted by pathname alone.
MAX_LINE = 64 * 1024            # one journal record / one FIFO command
MAX_FILE = 1 << 20              # any state or config file we read whole
MAX_ACCOUNTS_FILE = 64 * 1024   # the accounts file is a handful of lines
MAX_FIELD = 512                 # one string field kept from a history record
MAX_HISTORY_RECORDS = 200       # records parsed out of history.jsonl
MAX_REPLY_CHARS = 8 * 1024      # baresip prose spliced into `status`
FIFO_TIMEOUT = 5.0              # seconds allowed to get a command into the FIFO

BARESIP_CONFIG = """\
# Generated by omarchy-sip -- edits are overwritten on daemon start.
poll_method\t\tepoll

sip_listen\t\t{listen}
sip_verify_server\tyes

audio_player\t\tpulse,default
audio_source\t\tpulse,default
audio_alert\t\tpulse,default
ausrc_srate\t\t0
auplay_srate\t\t0
audio_txmode\t\tpoll

module_path\t\t/usr/lib/baresip/modules

# transport / nat
module\t\t\tstun.so
module\t\t\tice.so
module\t\t\tsrtp.so
module\t\t\tuuid.so
# Laptops move between networks. Without netroam baresip keeps trying to send
# from a local address that no longer exists and registration dies with
# "Network is unreachable [101]" until the daemon is restarted by hand.
module\t\t\tnetroam.so

# codecs -- g711 is the universal floor, opus for anything that offers it
module\t\t\topus.so
module\t\t\tg711.so

# audio device
module\t\t\tpulse.so

# call control
module\t\t\taccount.so
module\t\t\tcontact.so
module\t\t\tmenu.so
module\t\t\tctrl_tcp.so

ctrl_tcp_listen\t\t{ctrl_host}:{ctrl_port}

# Never auto-answer: the panel decides, so an inbound call rings instead.
answer_mode\t\tmanual
"""

UNIT_TEMPLATE = """\
[Unit]
Description=Simple SIP daemon (baresip + omarchy-sip control bridge)
After=pipewire.service pipewire-pulse.service
Wants=pipewire-pulse.service

[Service]
Type=simple
ExecStart={python} {self} daemon
Restart=always
RestartSec=3
# baresip is a child of the daemon; take the whole group down on stop.
KillMode=control-group

[Install]
WantedBy=default.target
"""


def die(message: str) -> "NoReturn":  # noqa: F821
    print(f"omarchy-sip: {message}", file=sys.stderr)
    raise SystemExit(1)


# --------------------------------------------------------------- ctrl_tcp wire


def netstring(payload: bytes) -> bytes:
    return b"%d:%s," % (len(payload), payload)


class NetstringDecoder:
    """Incremental netstring reader -- TCP gives no framing guarantees.

    Both the declared length and the buffer are capped. A bogus length prefix
    would otherwise have us wait on -- and hold -- an unbounded payload, and a
    stream with no ':' at all would grow the buffer forever.
    """

    MAX_PREFIX = 20   # a decimal length prefix is never longer than this

    def __init__(self, limit: int = MAX_LINE) -> None:
        self._buf = b""
        self._limit = limit

    def feed(self, data: bytes):
        self._buf += data
        while True:
            head, sep, rest = self._buf.partition(b":")
            if not sep:
                if len(self._buf) > self.MAX_PREFIX:
                    raise ValueError("netstring length prefix too long")
                return
            if not head.isdigit():
                raise ValueError(f"malformed netstring length: {head!r}")
            length = int(head)
            if length > self._limit:
                raise ValueError(f"netstring payload too large: {length}")
            if len(rest) < length + 1:  # payload + trailing comma
                return
            yield rest[:length]
            self._buf = rest[length + 1 :]


def command_json(name: str, params: str | None, token: str | None) -> str:
    obj: dict[str, str] = {"command": name}
    if params:
        obj["params"] = params
    if token:
        obj["token"] = token
    return json.dumps(obj, separators=(",", ":"))


# --------------------------------------------------------------- config on disk


def secure_dir(path: str) -> str:
    """Create `path` privately, and refuse to use anything else by that name.

    Both of our directories hold secrets (the accounts file carries the SIP
    password) and control objects (the command FIFO), so a pre-created symlink
    or a directory owned by somebody else is a substitution attempt, not
    something to quietly write into.
    """
    parent = os.path.dirname(path.rstrip("/"))
    if parent:
        os.makedirs(parent, exist_ok=True)
    try:
        os.mkdir(path, 0o700)
    except FileExistsError:
        pass
    except OSError as exc:
        die(f"cannot create {path}: {exc}")
    st = os.lstat(path)                  # lstat: a symlink here is never ours
    if not stat.S_ISDIR(st.st_mode):
        die(f"{path} is not a directory")
    if st.st_uid != os.getuid():
        die(f"{path} is not owned by this user")
    if st.st_mode & 0o077:
        os.chmod(path, 0o700)
    return path


def open_checked(
    path: str,
    flags: int,
    mode: int = 0o600,
    want=stat.S_ISREG,
    blocking: bool = True,
) -> int:
    """os.open with the checks a shared directory demands.

    O_NOFOLLOW refuses a symlink swapped in for the name; O_NONBLOCK means a
    FIFO swapped in for a regular file cannot park us inside open(); and the
    type/owner test runs on fstat of the very descriptor we go on to use, so it
    cannot be raced between the check and the read.
    """
    fd = os.open(path, flags | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC, mode)
    try:
        st = os.fstat(fd)
        if not want(st.st_mode):
            raise OSError(errno.EINVAL, f"{path} is not the expected file type")
        if st.st_uid != os.getuid():
            raise OSError(errno.EPERM, f"{path} is not owned by this user")
        # O_NONBLOCK was only ever an open()-time guard for everything but the
        # FIFO the daemon polls, so restore the mode the caller actually wants.
        os.set_blocking(fd, blocking)
    except OSError:
        os.close(fd)
        raise
    return fd


def read_bounded(path: str, limit: int = MAX_FILE) -> str:
    """Whole-file read through a validated descriptor, capped at `limit`."""
    try:
        fd = open_checked(path, os.O_RDONLY)
    except OSError:
        return ""
    try:
        chunks: list[bytes] = []
        got = 0
        while got < limit:
            chunk = os.read(fd, min(65536, limit - got))
            if not chunk:
                break
            chunks.append(chunk)
            got += len(chunk)
        return b"".join(chunks).decode("utf-8", "replace")
    except OSError:
        return ""
    finally:
        os.close(fd)


def write_file(path: str, content: str, mode: int = 0o600) -> None:
    """Create/replace a file at exactly `mode`, never following a symlink."""
    fd = open_checked(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, mode)
    try:
        os.fchmod(fd, mode)    # on the descriptor: no pathname to re-resolve
        data = content.encode("utf-8")
        while data:
            data = data[os.write(fd, data) :]
    finally:
        os.close(fd)


def write_private(path: str, content: str) -> None:
    """Create/replace a 0600 file without ever widening its mode."""
    write_file(path, content, 0o600)


def ensure_config() -> None:
    secure_dir(CONF_DIR)
    accounts = os.path.join(CONF_DIR, "accounts")
    if not os.path.lexists(accounts):
        write_private(accounts, "")
    contacts = os.path.join(CONF_DIR, "contacts")
    if not os.path.lexists(contacts):
        write_private(contacts, "")
    # Regenerated every start: the module list and control port are ours, not
    # the user's, so a stale config can never quietly break calls.
    write_private(
        os.path.join(CONF_DIR, "config"),
        BARESIP_CONFIG.format(
            listen=SIP_LISTEN, ctrl_host=CTRL_HOST, ctrl_port=CTRL_PORT
        ),
    )


def unit_python() -> str:
    """Interpreter to bake into the unit.

    A `#!/usr/bin/env python3` shebang can resolve to a version manager's shim
    (mise, pyenv, asdf), which would leave the service pointing at an
    interpreter that can disappear under it. Prefer the distro python, which is
    always present on Arch, and only fall back to whatever is running us.
    """
    return "/usr/bin/python3" if os.path.exists("/usr/bin/python3") else sys.executable


def write_unit() -> None:
    os.makedirs(os.path.dirname(UNIT_FILE), exist_ok=True)
    write_file(UNIT_FILE, UNIT_TEMPLATE.format(self=SELF, python=unit_python()), 0o644)
    systemctl("daemon-reload")


def systemctl(*args: str, check: bool = False) -> int:
    return subprocess.run(
        ["systemctl", "--user", *args], check=check, capture_output=True
    ).returncode


def clip(value, limit: int = MAX_FIELD) -> str:
    return str(value)[:limit]


def account_aor() -> str:
    """AOR from the first meaningful line of the accounts file."""
    accounts = os.path.join(CONF_DIR, "accounts")
    for line in read_bounded(accounts, MAX_ACCOUNTS_FILE).split("\n"):
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        line = line.split(";", 1)[0]
        if "<" in line:
            line = line[line.index("<") + 1 :]
        return clip(line.rstrip(">").strip())
    return ""


# ------------------------------------------------------------------- the daemon


# Opened once by the daemon and reused for every append, so the journal a
# running daemon writes to cannot be swapped out from under it.
_events_fd: int | None = None


def open_events() -> int:
    return open_checked(EVENTS, os.O_WRONLY | os.O_CREAT | os.O_APPEND)


def write_event(text: str) -> None:
    """Append one record to the journal, capped at MAX_LINE.

    One line per object is the contract the panel's SplitParser and our own
    follow() rely on, so newlines are flattened and an oversized record is
    replaced by a marker rather than passed through.
    """
    text = text.replace("\r", " ").replace("\n", " ")
    if len(text) > MAX_LINE:
        text = json.dumps(
            {"type": "EVENT_DROPPED", "reason": "oversized record"},
            separators=(",", ":"),
        )
    data = (text + "\n").encode("utf-8", "replace")
    if _events_fd is not None:
        os.write(_events_fd, data)
        return
    try:
        fd = open_events()
    except OSError:
        return                 # no journal to write to; nothing to be done
    try:
        os.write(fd, data)
    finally:
        os.close(fd)


def journal(obj: dict) -> None:
    write_event(json.dumps(obj, separators=(",", ":")))


HISTORY_FILE = os.path.join(CONF_DIR, "history.jsonl")
HISTORY_LIMIT = 50


class CallTracker:
    """Turns the event stream into a persistent call log.

    This lives in the daemon rather than the panel because the daemon is the
    only thing running continuously: a call that starts and ends while the
    shell is restarting still gets recorded. A call is "missed" when it came
    in and never reached CALL_ESTABLISHED.
    """

    def __init__(self, path: str, limit: int = HISTORY_LIMIT) -> None:
        self.path = path
        self.limit = limit
        self.open_calls: dict[str, dict] = {}

    def handle(self, event: dict) -> None:
        etype = event.get("type")
        call_id = event.get("id") or "-"
        if etype in ("CALL_INCOMING", "CALL_OUTGOING"):
            self.open_calls[call_id] = {
                "direction": "in" if etype == "CALL_INCOMING" else "out",
                "peer": event.get("peeruri") or "",
                "started": time.time(),
                "answered": False,
                "answeredAt": 0.0,
            }
        elif etype == "CALL_ESTABLISHED":
            call = self.open_calls.get(call_id)
            if call:
                call["answered"] = True
                call["answeredAt"] = time.time()
        elif etype == "CALL_CLOSED":
            call = self.open_calls.pop(call_id, None)
            if call:
                self.append(call, event.get("param") or "")

    def append(self, call: dict, reason: str) -> None:
        now = time.time()
        record = {
            "ts": round(call["started"], 3),
            "direction": call["direction"],
            "peer": call["peer"],
            # An unanswered inbound call is a miss; an unanswered outbound one
            # is just a call that was not picked up.
            "missed": call["direction"] == "in" and not call["answered"],
            "duration": int(now - call["answeredAt"]) if call["answered"] else 0,
            "reason": reason,
        }
        try:
            lines = self.read_lines()
            lines.append(json.dumps(record, separators=(",", ":")))
            write_private(self.path, "\n".join(lines[-self.limit :]) + "\n")
        except OSError:
            pass   # history is a nicety; never let it take the daemon down

    def read_lines(self) -> list[str]:
        lines = []
        for raw in read_bounded(self.path).split("\n"):
            raw = raw.strip()
            if not raw or len(raw) > MAX_LINE:
                continue       # oversized: not a record this daemon wrote
            lines.append(raw)
        return lines[-MAX_HISTORY_RECORDS:]


def history_record(obj: dict) -> dict:
    """Keep only the fields the panel renders, at bounded sizes.

    The file is ours, but it is an ordinary user-writable file: a substituted
    history must not be able to hand the panel a megabyte-long "peer".
    """
    return {
        "ts": float(obj.get("ts") or 0),
        "direction": "in" if obj.get("direction") == "in" else "out",
        "peer": clip(obj.get("peer") or ""),
        "missed": obj.get("missed") is True,
        "duration": max(0, min(int(obj.get("duration") or 0), 7 * 86400)),
        "reason": clip(obj.get("reason") or ""),
    }


def read_history(limit: int) -> list[dict]:
    """Most recent first."""
    limit = max(0, min(int(limit), MAX_HISTORY_RECORDS))
    out: list[dict] = []
    if limit == 0:
        return out
    for line in reversed(CallTracker(HISTORY_FILE).read_lines()):
        try:
            obj = json.loads(line)
            if not isinstance(obj, dict):
                continue
            out.append(history_record(obj))
        except (ValueError, TypeError):
            continue
        if len(out) >= limit:
            break
    return out


def clip_reply(reply: dict | None) -> dict | None:
    """Cap a baresip reply before it is spliced into the `status` snapshot.

    baresip answers in prose of its own choosing; the panel should never be
    handed an unbounded string just because a reply was long.
    """
    if not isinstance(reply, dict):
        return None
    out: dict = {}
    for key, value in list(reply.items())[:16]:
        out[clip(key, 64)] = clip(value, MAX_REPLY_CHARS) if isinstance(value, str) else value
    return out


def ctrl_port_open() -> bool:
    with socket.socket() as probe:
        probe.settimeout(0.25)
        return probe.connect_ex((CTRL_HOST, CTRL_PORT)) == 0


def cmd_daemon(_args) -> int:
    if not shutil.which("baresip"):
        die("baresip is not installed (pacman -S baresip)")
    global _events_fd
    ensure_config()
    secure_dir(RUN_DIR)
    if os.path.lexists(FIFO):
        os.unlink(FIFO)        # replaced, never opened by name, whatever it was
    os.mkfifo(FIFO, 0o600)
    write_private(EVENTS, "")  # fresh journal, 0600, no symlink followed
    _events_fd = open_events()

    # Refuse to adopt somebody else's baresip: a stale instance holding the
    # control port would be driven as if it were ours, while our own baresip
    # failed to bind ctrl_tcp in silence.
    if ctrl_port_open():
        journal({"type": "CTRL_FAILED", "reason": "control port already in use"})
        die(f"{CTRL_HOST}:{CTRL_PORT} is already in use -- another baresip is running")

    # Truncated per start rather than appended forever: this lives in the
    # runtime dir (tmpfs), so an unbounded log is an unbounded allocation. It
    # records peer URIs, so it is 0600 like the rest -- write_private both
    # creates it and narrows an inherited wider mode.
    write_private(BARESIP_LOG, "")
    log_fd = open_checked(BARESIP_LOG, os.O_WRONLY | os.O_APPEND)
    baresip = subprocess.Popen(
        ["baresip", "-f", CONF_DIR], stdout=log_fd, stderr=subprocess.STDOUT
    )

    def shutdown(*_):
        baresip.terminate()
        try:
            os.unlink(FIFO)
        except OSError:
            pass
        raise SystemExit(1)

    signal.signal(signal.SIGTERM, shutdown)
    signal.signal(signal.SIGINT, shutdown)

    sock = None
    for _ in range(100):
        if baresip.poll() is not None:
            journal({"type": "CTRL_FAILED", "reason": "baresip exited during startup"})
            die(f"baresip exited immediately -- see {BARESIP_LOG}")
        try:
            sock = socket.create_connection((CTRL_HOST, CTRL_PORT), timeout=0.5)
            break
        except OSError:
            time.sleep(0.1)
    if sock is None:
        journal({"type": "CTRL_FAILED", "reason": "control port never opened"})
        baresip.terminate()
        die(f"baresip did not open {CTRL_HOST}:{CTRL_PORT} -- see {BARESIP_LOG}")

    sock.settimeout(None)
    journal({"type": "CTRL_CONNECTED"})

    # O_RDWR keeps the FIFO open across writers, so `read` never sees EOF and
    # the loop does not spin between commands.
    fifo_fd = open_checked(FIFO, os.O_RDWR, want=stat.S_ISFIFO, blocking=False)

    decoder = NetstringDecoder()
    tracker = CallTracker(HISTORY_FILE)
    pending = b""
    dropping = False
    sel = selectors.DefaultSelector()
    sel.register(sock, selectors.EVENT_READ, "sock")
    sel.register(fifo_fd, selectors.EVENT_READ, "fifo")

    try:
        while True:
            if baresip.poll() is not None:
                journal({"type": "CTRL_FAILED", "reason": "baresip exited"})
                return 1
            for key, _ in sel.select(timeout=2.0):
                if key.data == "sock":
                    chunk = sock.recv(65536)
                    if not chunk:
                        journal({"type": "CTRL_DISCONNECTED"})
                        return 1
                    try:
                        payloads = list(decoder.feed(chunk))
                    except ValueError as exc:
                        # Framing is broken or oversized; there is no safe point
                        # to resynchronise from, so let systemd restart us.
                        journal({"type": "CTRL_FAILED", "reason": f"bad framing: {exc}"})
                        return 1
                    for payload in payloads:
                        text = payload.decode("utf-8", "replace")
                        # Pass baresip's own JSON through verbatim -- one line
                        # per object, which is what the panel's SplitParser
                        # expects. Safe because JSON escapes newlines.
                        write_event(text)
                        try:
                            tracker.handle(json.loads(text))
                        except ValueError:
                            pass
                else:
                    try:
                        data = os.read(fifo_fd, 65536)
                    except OSError as exc:
                        if exc.errno in (errno.EAGAIN, errno.EWOULDBLOCK):
                            continue
                        raise
                    pending += data
                    while b"\n" in pending:
                        line, _, pending = pending.partition(b"\n")
                        if dropping:      # tail of a command we already dropped
                            dropping = False
                            continue
                        if len(line) > MAX_LINE:
                            journal({"type": "CMD_DROPPED", "reason": "oversized command"})
                            continue
                        line = line.strip()
                        if line:
                            sock.sendall(netstring(line))
                    if len(pending) > MAX_LINE:
                        # A writer that never sends a newline must not grow this
                        # buffer without limit. Drop what it sent and resume at
                        # the next newline.
                        journal({"type": "CMD_DROPPED", "reason": "oversized command"})
                        pending = b""
                        dropping = True
    finally:
        sel.close()
        sock.close()
        os.close(fifo_fd)
        os.close(log_fd)
        if _events_fd is not None:
            os.close(_events_fd)
            _events_fd = None
        baresip.terminate()
        try:
            os.unlink(FIFO)
        except OSError:
            pass


def daemon_up() -> bool:
    """The FIFO exists only while a daemon holds it, systemd or not."""
    try:
        return stat.S_ISFIFO(os.lstat(FIFO).st_mode)   # lstat: not via a symlink
    except OSError:
        return False


# ------------------------------------------------------------------ subcommands


def write_fifo(line: str) -> None:
    """Hand one command line to the daemon, or fail -- but never hang.

    The descriptor is the check: O_NOFOLLOW|O_NONBLOCK plus an fstat for a FIFO
    we own means a symlink, a regular file or a FIFO with no reader all fail
    here instead of blocking the caller (and, for the panel, its UI thread).
    """
    if len(line) > MAX_LINE:
        die("command is too long")
    try:
        fd = open_checked(FIFO, os.O_WRONLY, want=stat.S_ISFIFO, blocking=False)
    except OSError:
        # ENOENT, ENXIO (no reader), ELOOP or a wrong file type all mean the
        # same thing to the caller: there is no daemon FIFO to talk to.
        die("daemon is not running (omarchy-sip start)")
    payload = (line + "\n").encode("utf-8")
    deadline = time.monotonic() + FIFO_TIMEOUT
    try:
        while payload:
            remaining = deadline - time.monotonic()
            if remaining <= 0 or not select.select([], [fd], [], remaining)[1]:
                die("timed out writing to the daemon")
            try:
                payload = payload[os.write(fd, payload) :]
            except BlockingIOError:
                continue
    finally:
        os.close(fd)


def follow(path: str, from_start: bool = False, deadline: float | None = None):
    """Yield appended lines, surviving the truncation a daemon restart does.

    Opening (and seeking to EOF) happens eagerly, before the first next(), so a
    caller can position the stream and only then send the command it expects a
    reply to.
    """
    fd = open_checked(path, os.O_RDONLY)
    if not from_start:
        os.lseek(fd, 0, os.SEEK_END)
    return _follow_fd(fd, path, deadline)


def _follow_fd(fd: int, path: str, deadline: float | None):
    """Line reader over one validated descriptor.

    Truncation is detected with fstat on *that* descriptor rather than
    getsize() on the name, so a file substituted mid-stream cannot redirect the
    reader, and a record longer than MAX_LINE is dropped rather than buffered.
    """
    buf = b""
    dropping = False
    try:
        while True:
            if deadline is not None and time.monotonic() > deadline:
                return
            chunk = os.read(fd, 65536)
            if chunk:
                buf += chunk
                while b"\n" in buf:
                    raw, _, buf = buf.partition(b"\n")
                    if dropping:      # tail of a record we already dropped
                        dropping = False
                        continue
                    if len(raw) > MAX_LINE:
                        continue      # oversized: never handed to a parser
                    yield raw.decode("utf-8", "replace")
                if len(buf) > MAX_LINE:
                    # No newline in sight: stop buffering and resynchronise at
                    # the next one rather than growing without limit.
                    buf = b""
                    dropping = True
                continue
            if os.fstat(fd).st_size < os.lseek(fd, 0, os.SEEK_CUR):
                os.close(fd)          # truncated -> reopen, same checks
                fd = open_checked(path, os.O_RDONLY)
                buf = b""
                dropping = False
                continue
            time.sleep(0.1)
    finally:
        os.close(fd)


def request(name: str, params: str | None = None, timeout: float = 5.0) -> dict | None:
    """Send a command and return the response object carrying our token."""
    token = f"cli-{os.getpid()}-{int(time.time() * 1000) % 100000}"
    deadline = time.monotonic() + timeout
    try:
        # Positioned at EOF before we send, so no race. The deadline lives in
        # the follower, so a silent journal cannot hold this process open.
        stream = follow(EVENTS, deadline=deadline)
    except OSError:
        return None
    try:
        write_fifo(command_json(name, params, token))
        for line in stream:
            try:
                obj = json.loads(line)
            except ValueError:
                continue
            if isinstance(obj, dict) and obj.get("token") == token:
                return obj
        return None
    finally:
        stream.close()


def cmd_install(_args) -> int:
    ensure_config()
    write_unit()
    systemctl("enable", "--now", UNIT)
    print(f"omarchy-sip: installed and started ({UNIT})")
    if not account_aor():
        print("omarchy-sip: no account yet -- run: omarchy-sip account set sip:you@example.com")
    return 0


def cmd_uninstall(_args) -> int:
    systemctl("disable", "--now", UNIT)
    if os.path.exists(UNIT_FILE):
        os.unlink(UNIT_FILE)
    systemctl("daemon-reload")
    print(f"omarchy-sip: unit removed (config in {CONF_DIR} kept)")
    return 0


def cmd_start(_args) -> int:
    if not os.path.exists(UNIT_FILE):
        write_unit()
        systemctl("enable", UNIT)
    ensure_config()
    return systemctl("start", UNIT)


def cmd_stop(_args) -> int:
    return systemctl("stop", UNIT)


def cmd_restart(_args) -> int:
    ensure_config()
    return systemctl("restart", UNIT)


def cmd_send(args) -> int:
    write_fifo(command_json(args.name, args.params, "panel"))
    return 0


def cmd_cmd(args) -> int:
    reply = request(args.name, args.params)
    if reply is None:
        die(f"timed out waiting for a response to '{args.name}'")
    print(json.dumps(reply, separators=(",", ":")))
    return 0 if reply.get("ok") else 1


def cmd_events(_args) -> int:
    if not daemon_up():
        die("daemon is not running (omarchy-sip start)")
    try:
        stream = follow(EVENTS)
    except OSError as exc:
        die(f"cannot read the event journal: {exc}")
    for line in stream:
        print(line, flush=True)
    return 0


def cmd_history(args) -> int:
    print(json.dumps(read_history(args.limit), separators=(",", ":")))
    return 0


def cmd_status(_args) -> int:
    up = daemon_up()
    snapshot = {
        "installed": os.path.exists(UNIT_FILE),
        "unitActive": systemctl("is-active", "--quiet", UNIT) == 0,
        "daemonUp": up,
        "configured": bool(account_aor()),
        "aor": account_aor(),
        # Raw baresip responses, spliced in as objects so the consumer needs a
        # single parse. Pulling state out of the prose is Model.js's job.
        "reginfo": clip_reply(request("reginfo", timeout=3)) if up else None,
        "calls": clip_reply(request("listcalls", timeout=3)) if up else None,
    }
    print(json.dumps(snapshot, separators=(",", ":")))
    return 0


def restart_if_live() -> None:
    """Bounce the daemon only if we edited the config dir the unit actually reads."""
    if CONF_DIR == DEFAULT_CONF_DIR and os.path.exists(UNIT_FILE):
        systemctl("restart", UNIT)


def read_password_from_stdin(timeout: float = 5.0) -> str:
    """Read the password from stdin, but never block forever.

    The panel writes the password to this process's stdin and then closes the
    pipe. If a caller ever writes without closing, a plain readline() would
    hang the process (and the panel's form with it), so wait on the descriptor
    and give up with an empty password instead.
    """
    if sys.stdin.isatty():
        return ""
    fd = sys.stdin.fileno()
    deadline = time.monotonic() + timeout
    buf = b""
    while True:
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            break
        if not select.select([fd], [], [], remaining)[0]:
            break
        chunk = os.read(fd, 4096)
        if not chunk:       # writer closed the pipe
            break
        buf += chunk
        if b"\n" in buf:    # a complete line is all we need
            break
    return buf.split(b"\n", 1)[0].decode("utf-8", "replace")


def cmd_account(args) -> int:
    accounts = os.path.join(CONF_DIR, "accounts")
    if args.action == "show":
        aor = account_aor()
        print(
            json.dumps(
                {"configured": bool(aor), "aor": aor, "accountsFile": accounts},
                separators=(",", ":"),
            )
        )
        return 0

    if args.action == "clear":
        write_private(accounts, "")
        restart_if_live()
        print("omarchy-sip: account cleared")
        return 0

    # set
    if not args.uri or not args.uri.startswith("sip:"):
        die("account set needs a sip: URI, e.g. sip:you@pbx.example.com")

    password = read_password_from_stdin()
    # baresip's accounts format is ;-delimited, so a ';' in a value cannot be
    # represented. Fail loudly rather than register with a truncated password.
    if ";" in password:
        die("password contains ';', which baresip's accounts format cannot store")

    entry = f'"{args.display_name}" ' if args.display_name else ""
    entry += f"<{args.uri}>"
    if args.auth_user:
        entry += f";auth_user={args.auth_user}"
    if password:
        entry += f";auth_pass={password}"
    entry += f";transport={args.transport}"
    if args.outbound:
        entry += f';outbound="{args.outbound}"'
    entry += f";answermode=manual;regint={args.regint}"
    entry += ";audio_codecs=opus/48000/2,PCMU/8000/1,PCMA/8000/1"

    ensure_config()
    write_private(accounts, entry + "\n")
    print(f"omarchy-sip: account set to {args.uri}")
    restart_if_live()
    return 0


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(
        prog="omarchy-sip", description="Simple SIP control surface"
    )
    sub = parser.add_subparsers(dest="sub", required=True)

    for name, fn, help_text in [
        ("daemon", cmd_daemon, "run the bridge in the foreground (used by the unit)"),
        ("install", cmd_install, "generate config, install and start the user service"),
        ("uninstall", cmd_uninstall, "stop and remove the user service (config kept)"),
        ("start", cmd_start, "start the daemon"),
        ("stop", cmd_stop, "stop the daemon"),
        ("restart", cmd_restart, "restart the daemon"),
        ("status", cmd_status, "JSON snapshot of unit, account and baresip state"),
        ("events", cmd_events, "stream the JSON event journal"),
    ]:
        sub.add_parser(name, help=help_text).set_defaults(func=fn)

    for name, fn, help_text in [
        ("send", cmd_send, "fire-and-forget baresip command"),
        ("cmd", cmd_cmd, "send a command and print the matching response"),
    ]:
        p = sub.add_parser(name, help=help_text)
        p.add_argument("name")
        p.add_argument("params", nargs="?")
        p.set_defaults(func=fn)

    p = sub.add_parser("history", help="recent calls as JSON, most recent first")
    p.add_argument("--limit", type=int, default=10)
    p.set_defaults(func=cmd_history)

    p = sub.add_parser("dial", help="place a call")
    p.add_argument("uri")
    p.set_defaults(func=lambda a: cmd_send(argparse.Namespace(name="dial", params=a.uri)))

    p = sub.add_parser("answer", help="accept the ringing call")
    p.set_defaults(func=lambda a: cmd_send(argparse.Namespace(name="accept", params=None)))

    p = sub.add_parser("hangup", help="end the current call")
    p.set_defaults(func=lambda a: cmd_send(argparse.Namespace(name="hangup", params=None)))

    p = sub.add_parser("account", help="show or set the SIP account")
    p.add_argument("action", choices=["show", "set", "clear"], nargs="?", default="show")
    p.add_argument("uri", nargs="?")
    p.add_argument("--auth-user")
    p.add_argument("--display-name")
    p.add_argument("--transport", choices=["udp", "tcp", "tls"], default="udp")
    p.add_argument("--outbound")
    p.add_argument("--regint", type=int, default=600)
    p.set_defaults(func=cmd_account)

    args = parser.parse_args(argv)
    return args.func(args) or 0


if __name__ == "__main__":
    try:
        raise SystemExit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        raise SystemExit(130)
